---
// Closing band. A quiet sign-off (name + role) rather than a contact CTA - the
// contact form is the canonical surface and sits just above on the homepage, so a
// second "drop me a line" link here would be redundant. Beside it: London
// coordinates, timezone and availability as plain right-aligned lines, then the
// copyright. Caps run through the .label / Raleway 500 / 0.22em system so the
// footer reads as one with the nav and the page kickers. (No raw email in the HTML
// for a harvester; social links omitted until real URLs exist.)
---
<footer aria-label="Site footer">
  <div class="footer-inner">
    <div class="footer-contact reveal">
      <p class="footer-name">Court Granville</p>
      <p class="footer-role">Multidisciplinary Designer</p>
    </div>

    <ul class="footer-locale">
      <li>51.5074&deg; N, 0.1278&deg; W</li>
      <li><time id="footer-clock">--:--</time> &middot; <span id="footer-tz">GMT</span></li>
      <li>Open to work</li>
    </ul>

    <div class="footer-baseline">
      <span class="footer-copyright">&copy; 2026 Court Granville</span>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--bg);
    border-top: 1px solid var(--rule);
    padding: clamp(56px, 9vh, 96px) var(--outer) 32px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'contact locale'
      'baseline baseline';
    gap: 60px 40px;
    align-items: start;
  }
  .footer-contact { grid-area: contact; }
  .footer-name {
    font-family: var(--serif); font-weight: 400;
    font-size: var(--fs-heading-s); line-height: var(--lh-heading-s);
    color: var(--text); margin: 0;
  }
  .footer-role {
    font-family: var(--serif); font-weight: 400;
    font-size: var(--fs-body-s); line-height: var(--lh-body-s);
    color: var(--text-quiet); margin: 14px 0 0;
  }

  /* Locale - London coordinates, timezone, status, as plain right-aligned lines. */
  .footer-locale {
    grid-area: locale;
    margin: 0; padding: 0; list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: right;
  }
  .footer-locale li {
    font-family: var(--sans);
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .footer-baseline {
    grid-area: baseline;
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
  }
  .footer-copyright {
    font-family: var(--sans);
    font-weight: 500;
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
      grid-template-areas: 'contact' 'locale' 'baseline';
      gap: 36px;
    }
    .footer-locale { text-align: left; }
  }
</style>

<script>
  // Live London time. The offset label is derived from the same zone as the
  // clock, so it reads GMT in winter and GMT + 1 under BST without manual swaps.
  const clockEl = document.getElementById('footer-clock');
  const tzEl = document.getElementById('footer-tz');
  if (clockEl) {
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit' });
    const off = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', timeZoneName: 'shortOffset' });
    const tick = () => {
      const now = new Date();
      clockEl.textContent = fmt.format(now);
      if (tzEl) {
        const name = off.formatToParts(now).find((p) => p.type === 'timeZoneName')?.value || 'GMT';
        tzEl.textContent = name.replace('GMT+1', 'GMT + 1'); // match the footer's spaced style
      }
    };
    tick();
    setInterval(tick, 30000);
  }
</script>
