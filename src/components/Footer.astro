---
// Closing band. "Get in touch" is the surface (→ the homepage contact form) — no
// raw email sits in the HTML for a harvester. London/Madrid coordinates, a live
// London clock beside the availability status, then the motto + copyright. All caps
// run through the .label / Raleway 500 / 0.22em system so the footer reads as one
// with the nav and the page kickers. (Social links omitted until real URLs exist.)
---
<footer aria-label="Site footer">
  <div class="footer-inner">
    <div class="footer-contact reveal">
      <span class="label">Get in touch</span>
      <a class="footer-reach" href="/#contact">Drop me a line &rarr;</a>
      <p class="footer-role">Court Granville &mdash; Multidisciplinary Designer</p>
    </div>

    <dl class="footer-locale">
      <div><dt>London</dt><dd>51.5074&deg; N, 0.1278&deg; W</dd></div>
      <div><dt>Madrid</dt><dd>40.4168&deg; N, 3.7038&deg; W</dd></div>
      <div><dt>London time</dt><dd><time id="footer-clock">&mdash;&mdash;</time></dd></div>
      <div><dt>Status</dt><dd>Open to work</dd></div>
    </dl>

    <div class="footer-baseline">
      <span class="footer-motto">Designed and built with curiosity in London &amp; Madrid.</span>
      <span class="footer-copyright">&copy; 2026 Court Granville</span>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--bg);
    border-top: 1px solid var(--rule);
    padding: clamp(56px, 9vh, 96px) var(--outer) 32px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'contact locale'
      'baseline baseline';
    gap: 60px 40px;
    align-items: start;
  }
  .footer-contact { grid-area: contact; }
  .footer-contact .label { display: block; margin-bottom: 12px; color: var(--text-quiet); }
  .footer-reach {
    font-family: var(--serif); font-weight: 400;
    font-size: var(--fs-heading-s); line-height: var(--lh-heading-s);
    color: var(--text);
    transition: color var(--dur-hover) var(--ease-out);
  }
  .footer-reach:hover { color: var(--accent); }
  .footer-role {
    font-family: var(--serif); font-weight: 400;
    font-size: var(--fs-body-s); line-height: var(--lh-body-s);
    color: var(--text-quiet); margin: 14px 0 0;
  }

  /* Locale — London / Madrid coordinates, live London clock, status. */
  .footer-locale {
    grid-area: locale;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: right;
  }
  .footer-locale div { display: flex; gap: 16px; align-items: baseline; justify-content: flex-end; }
  .footer-locale dt,
  .footer-locale dd {
    margin: 0;
    font-family: var(--sans);
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }
  .footer-locale dt { color: var(--text-quiet); }
  .footer-locale dd { color: var(--text-faint); font-variant-numeric: tabular-nums; }

  .footer-baseline {
    grid-area: baseline;
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
  }
  .footer-motto {
    font-family: var(--serif); font-weight: 400; font-style: italic;
    font-size: var(--fs-body-s); line-height: var(--lh-body-s);
    color: var(--text-quiet);
  }
  .footer-copyright {
    font-family: var(--sans);
    font-weight: 500;
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
      grid-template-areas: 'contact' 'locale' 'baseline';
      gap: 36px;
    }
    .footer-locale { text-align: left; }
    .footer-locale div { justify-content: flex-start; }
  }
</style>

<script>
  // Live London clock — updates the footer time every 30s.
  const clockEl = document.getElementById('footer-clock');
  if (clockEl) {
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit' });
    const tick = () => { clockEl.textContent = fmt.format(new Date()); };
    tick();
    setInterval(tick, 30000);
  }
</script>
