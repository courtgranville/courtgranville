---
// Site-wide layout. Loads tokens, fonts and globals; hosts the WebGL import
// map in the document head so the hero's <script is:inline> can resolve
// `three`, `lil-gui` and `lenis` without going through Vite's bundler.
//
// Pinning the CDN-loaded versions here (jsDelivr) per CLAUDE.md so a moving
// "latest" cannot drift the hero's behaviour.

import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Court Granville',
  description = 'Court Granville is a multidisciplinary designer working across product, interaction, data visualisation and the web - translating complex, contested subjects into things people can understand and use. London & Madrid.',
} = Astro.props;

// Absolute URLs for canonical + social cards (Astro.site is set in config).
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---
<!doctype html>
<html lang="en-GB">
  <head>
    <!-- Theme - set on <html> BEFORE the stylesheets load, so there's no flash.
         The site ALWAYS opens in dark (its signature ground); the nav toggle still
         switches within a session, but the choice is intentionally NOT persisted,
         so every fresh load starts dark again. (To remember the choice instead,
         restore the localStorage read here and the setItem in Nav.astro.) -->
    <script is:inline>
      document.documentElement.dataset.theme = 'dark';
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0E0E0E" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Court Granville" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Every page loads Lenis (and the homepage three.js + addons) from
         jsDelivr via the importmap below; warm the connection at first parse
         so the heaviest critical resource isn't waiting on DNS/TLS. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <!-- Fonts as a parallel <link> (not a CSS @import in the bundle), so the
         request starts at first HTML parse instead of chaining behind the
         bundle CSS. display=swap avoids flash-of-invisible-text; the hero's
         document.fonts.ready gate is unaffected. See src/styles/fonts.css. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Raleway:wght@400;500;600&display=swap"
    />

    <script type="importmap" is:inline>
      {
        "imports": {
          "three": "https://cdn.jsdelivr.net/npm/three@0.162.0/build/three.module.js",
          "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.162.0/examples/jsm/",
          "lenis": "https://cdn.jsdelivr.net/npm/lenis@1.3.23/dist/lenis.mjs"
        }
      }
    </script>
  </head>
  <body id="top">
    <slot />

    <script is:inline type="module">
      // ─────────────────────────────────────────────────────────────────────
      // Site-wide client behaviours: Lenis smooth scroll, reveal observer,
      // nav scroll-state toggle, and the placeholder-link guard.
      //
      // Behaviours ported from the proven prototypes/hero/index.html.
      //
      // The homepage's hero dispatches a `hero:loaded` CustomEvent on `window`
      // when the particle load-in finishes; we use that to fade the nav in.
      // Pages without a hero (Work) have no such event - we detect the
      // absence of `.hero-section` and fade the nav in immediately, with the
      // scroll backdrop already on so it reads cleanly over content.
      // ─────────────────────────────────────────────────────────────────────
      import Lenis from 'lenis';

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const navEl   = document.querySelector('.site-nav');
      // A "hero" is either the legacy CG hero or the homepage scroll-narrative stage;
      // both dispatch `hero:loaded` and fade the nav in after their load-in.
      const heroEl  = document.querySelector('.hero-section') || document.querySelector('.scroll-stage');

      // On pages without a hero, the nav comes in immediately with the
      // backdrop on - there is no load-in moment to wait for.
      if (navEl && !heroEl) {
        navEl.classList.add('in', 'scrolled');
      }

      // Link handling:
      //  - `href="#"` placeholders are inert (would otherwise jolt to the top).
      //  - Same-page hash links (`/#about`, `#contact`) smooth-scroll to the section
      //    WHEN it exists on this page (the homepage); off the homepage they fall
      //    through to a normal navigation to `/#id`, and the browser jumps on load.
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a');
        if (!a) return;
        const href = a.getAttribute('href');
        if (href === '#') { e.preventDefault(); return; }
        const m = href && href.match(/^\/?#(.+)$/);
        if (!m) return;
        const target = document.getElementById(m[1]);
        if (!target) return;                 // not on this page → let it navigate
        e.preventDefault();
        if (lenis) lenis.scrollTo(target, { offset: -92 });
        else target.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth' });
        history.replaceState(null, '', href);
      });

      // Smooth-scroll. The homepage's ScrollHero owns a tuned Lenis (it runs the
      // scroll narrative) and exposes it as window.__cgLenis; on the homepage we share
      // that single instance rather than starting a second (two would fight). Its own
      // render loop already advances it, so we don't start a raf here in that case.
      let lenis = window.__cgLenis || null;
      if (!lenis && !reducedMotion) {
        lenis = new Lenis({
          duration: 0.8,
          easing:   (x) => Math.min(1, 1.001 - Math.pow(2, -10 * x)),
          smoothWheel: true,
          smoothTouch: false,
        });
        const lenisRaf = (time) => { lenis.raf(time); requestAnimationFrame(lenisRaf); };
        requestAnimationFrame(lenisRaf);
      }
      function scrollToTop() {
        if (lenis) lenis.scrollTo(0, { duration: 1.2 });
        else window.scrollTo({ top: 0, behavior: 'auto' });
      }
      document.querySelectorAll('[data-scroll-top]').forEach(el => {
        el.addEventListener('click', (e) => { e.preventDefault(); scrollToTop(); });
      });

      // Scroll-driven UI:
      //   - Fade the SCROLL cue out as soon as scrolling begins.
      //   - Toggle .scrolled on the nav once past the hero (homepage only).
      const cueEl = document.getElementById('scrollCue');
      function onScroll() {
        const y = window.scrollY || window.pageYOffset;
        if (cueEl) {
          const fade = Math.max(0, 1 - y / 90);
          cueEl.style.opacity = String(fade * 0.55);
        }
        if (heroEl && navEl) {
          const navThreshold = window.innerHeight - 80;
          navEl.classList.toggle('scrolled', y > navThreshold);
        }
      }
      if (lenis) lenis.on('scroll', onScroll);
      else window.addEventListener('scroll', onScroll, { passive: true });

      // Reveal - IntersectionObserver, single trigger per element. Works for
      // any `.reveal` on the page, including elements added later (a fresh
      // observer is started for each).
      const revealObserver = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            revealObserver.unobserve(e.target);
          }
        }
      }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
    </script>
  </body>
</html>
