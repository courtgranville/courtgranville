---
// ScrollHero - the homepage's scroll-driven particle narrative. One vanilla
// three.js canvas (the proven engine from prototypes/hero/_scroll-narrative.html)
// plays a single continuous story as you scroll:
//
//   CG glyph (the hero, kept) → enveloping dispersal → each product's particles
//   build into the REAL textured GLB (grab-and-spin) → adjust directly into the
//   next product → … → the final product (Spider-209) rests at the bottom of the
//   stage and scrolls straight up into the editorial body below (which opens with
//   the About "In short." section). There is NO "Selected Work" particle-text
//   divider - that interstitial was removed; "Selected Work" survives only as the
//   kicker on each product's overlay copy.
//
// Architecture (per CLAUDE.md): vanilla `<script is:inline type="module">` so the
// three / three/addons / lenis specifiers resolve through Layout.astro's CDN import
// map - no bundling, one three.js on the homepage. The models are the optimised
// meshopt+WebP GLBs in public/models/ (no DRACO). It OWNS the page's Lenis instance
// (exposed as window.__cgLenis) so Layout shares it instead of creating a second.
//
// This replaces Hero.astro + Carousel.astro on the homepage; the editorial body -
// the single-page identity narrative (About → Disciplines → Approach → Beginnings
// → Writing → Colophon → Contact) - follows in normal flow and occludes the sticky
// canvas. It dispatches `hero:loaded` (see below) once the load-in completes; Nav
// fades in on that event.

import NuclearAtom from './nuclear/NuclearAtom';
import '../styles/atom.css';

// The curated four-product sequence (a subset of the full /work index). Kept here
// for the SSR/no-JS link list; the engine's BEAT config (with view angles + model
// files) mirrors these in the inline script below - keep the two in sync.
const PRODUCTS = [
  { name: 'Mantis',                  year: 2026, discipline: 'Product Design', slug: 'mantis',     desc: 'A side table in need of repair, reborn as a standing lamp.' },
  { name: 'Wave',                    year: 2026, discipline: 'Product Design', slug: 'wave',       desc: 'A salvaged pair of speakers, rebuilt into a custom enclosure.' },
  { name: 'Gravity Wave Backgammon', year: 2024, discipline: 'Product Design', slug: 'backgammon', desc: 'A sheet of recycled ocean plastic turned into a backlit backgammon board.' },
  { name: 'Spider-209',              year: 2022, discipline: 'Product Design', slug: 'spider-209', desc: 'A classic lamp design reimagined as a desk lamp from materials found on the streets of Madrid.' },
];
---
<div class="scroll-stage" id="cgStage">
  <div class="cg-sticky">
    <canvas id="c" aria-hidden="true"></canvas>

    <!-- Static fallback, shown only if WebGL is unavailable or its context is lost: the
         particle hero cannot run, so we present the CG monogram as plain type. The real
         project links + page heading live in the sr-only block below, so content and SEO
         are unaffected either way. -->
    <div class="cg-fallback" id="cgFallback" aria-hidden="true">CG</div>

    <!-- The live nucleus atom - the homepage's TNQ beat. The dust builds the
         nucleus, then crossfades to this real interactive atom (engine drives its
         position + opacity per beat). Sits above the canvas, below the copy.
         Hydrated with client:idle, not client:visible: the overlay is full-screen
         and so technically "visible" from first paint, which would hydrate this
         React island during the load window - exactly when ScrollHero's three.js
         init is already saturating the main thread. The atom isn't the first beat
         (the user must scroll past the CG glyph to reach it) and its overlay opacity
         starts at 0, so deferring hydration to browser-idle keeps it off the
         critical path with no visible change. -->
    <div class="cg-atom-overlay" id="atomOverlay" aria-hidden="true">
      <NuclearAtom client:idle roomLink={false} lowDensity />
    </div>

    <!-- Overlay copy - phases in/out per beat, driven by the engine. -->
    <div class="cg-overlay" aria-hidden="false">
      <!-- Beat 0 - the multidisciplinary positioning paragraph, beside the glyph.
           The name now lives in the nav brand, so the visible heading is gone; the
           h1 stays (screen-reader-only) to keep the homepage's page heading for SEO. -->
      <div class="ov-block ov-lead">
        <h1 class="sr-only">Court Granville - Multidisciplinary Designer, London &amp; Madrid</h1>
        <p class="ov-lead-p">I&rsquo;m a multidisciplinary designer working across product, UX, data and the web. I trained in product design but am now pulled toward technology, heavy industries and AI - the industries, systems and problems where design solutions are needed most, whatever shape they take.</p>
      </div>

      <!-- Product beats - one block, contents swapped by the engine per product. A
           "Selected Work" kicker labels them all as such. -->
      <div class="ov-block ov-product" id="ovProduct">
        <span class="ov-kicker label">Selected Work</span>
        <span class="ov-index" id="ovIndex">01 / 05</span>
        <h2 class="ov-name" id="ovName">{PRODUCTS[0].name}</h2>
        <div class="ov-meta" id="ovMeta">{PRODUCTS[0].year} &middot; {PRODUCTS[0].discipline}</div>
        <p class="ov-desc" id="ovDesc">{PRODUCTS[0].desc}</p>
        <a class="ov-link" id="ovLink" href={`/work/${PRODUCTS[0].slug}/`}>View project &rarr;</a>
        <span class="ov-hint">Drag to spin</span>
      </div>
    </div>

    <div class="cg-cue" id="scrollCue">Scroll<span class="cg-arrow">&darr;</span></div>
    <div class="cg-beats" id="beatDots"></div>
  </div>

  <!-- Real, crawlable links to every featured project (work-first; present without JS).
       The Nuclear Question is a featured beat but not in PRODUCTS (it has no GLB), so
       it gets its own entry here. -->
  <ul class="sr-only">
    <li><a href="/work/the-nuclear-question/">The Nuclear Question - 2026, Data Visualisation</a></li>
    {PRODUCTS.map((p) => (
      <li><a href={`/work/${p.slug}/`}>{p.name} - {p.year}, {p.discipline}</a></li>
    ))}
  </ul>
</div>

<style>
  /* The scroll stage: a tall driver (its height is set by the engine) with a
     sticky, full-viewport canvas pinned for the narrative's duration. */
  .scroll-stage { position: relative; width: 100%; z-index: 1; }
  .cg-sticky {
    position: sticky; top: 0;
    width: 100%; height: 100vh;
    overflow: hidden;
  }
  #c { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }
  #c.grabbable { cursor: grab; }
  #c.grabbing  { cursor: grabbing; }

  /* WebGL-unavailable fallback - the CG monogram as plain type, in the hero's place.
     Hidden until the engine reveals it (.show); respects the theme via --text. */
  .cg-fallback {
    position: absolute; inset: 0; z-index: 0; display: none;
    align-items: center; justify-content: center;
    font-family: var(--serif); font-weight: 700; color: var(--text);
    font-size: clamp(120px, 22vw, 340px); line-height: 1; letter-spacing: -0.02em;
    user-select: none; pointer-events: none;
  }
  .cg-fallback.show { display: flex; }
  /* On wide screens sit it to the right (where the live glyph normally is) so it clears
     the left-hand intro copy rather than overlapping it. */
  @media (min-width: 900px) { .cg-fallback { justify-content: flex-end; padding-right: max(48px, 7vw); } }

  /* The live atom overlay - full-screen so the fission particles can fly across
     the whole stage, while the nucleus FORM is drawn small at the model region
     (the engine sets --form-cx/cy/r). Above the canvas, below the copy; the
     engine drives opacity (crossfade per beat) and only captures the pointer once
     the atom is formed, so scrolling past is free. */
  .cg-atom-overlay { position: absolute; inset: 0; z-index: 1; opacity: 0; pointer-events: none; }
  .cg-atom-overlay :global(.atom),
  .cg-atom-overlay :global(.atom .hero-icon) { width: 100%; height: 100%; }
  /* Controls anchor to the form box's bottom-right corner (engine-set vars), out
     of the way of the form; right-aligned so the label sits over the switch. */
  .cg-atom-overlay :global(.atom-control) {
    top: auto; left: auto;
    right: var(--atom-ctl-right, 20px); bottom: var(--atom-ctl-bottom, 20px);
    align-items: flex-end;
  }
  .cg-atom-overlay :global(.atom-hint) {
    top: var(--atom-hint-y, auto); bottom: auto;
    left: var(--atom-hint-x, 50%); right: auto;
    transform: translateX(-50%); width: max-content;
  }

  /* Overlay - above the canvas, pointer-transparent except real links. */
  .cg-overlay { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .ov-block { position: absolute; opacity: 0; will-change: opacity; }
  .ov-block a { pointer-events: auto; }

  /* Hero lead - the positioning paragraph, left and vertically centred beside the
     centred glyph (translateY(-50%) centres the block on its own height, so the
     paragraph sits level with the hero interaction now the name has moved to the nav). */
  .ov-lead {
    left: var(--outer); top: 50%; transform: translateY(-50%);
    width: min(520px, 36vw);
  }
  .ov-lead-p {
    font-family: var(--sans); font-weight: 400;
    font-size: var(--fs-body); line-height: var(--lh-body); color: var(--text); margin: 0;
  }

  /* Per-product chrome - left column, mirroring the editorial carousel voice. */
  .ov-product {
    left: var(--outer); top: 50%; transform: translateY(-50%);
    display: flex; flex-direction: column; align-items: flex-start; width: min(520px, 36vw);
  }
  .ov-kicker { display: block; color: var(--text-faint); margin-bottom: 14px; }
  .ov-index {
    font-family: var(--sans); font-weight: 500;
    font-size: var(--fs-label); letter-spacing: var(--ls-label); text-transform: uppercase;
    color: var(--text-faint); font-variant-numeric: tabular-nums; margin-bottom: 18px;
  }
  .ov-name {
    font-family: var(--serif); font-weight: 400;
    font-size: var(--fs-heading-m); line-height: var(--lh-heading-m);
    color: var(--text); margin: 0 0 14px;
  }
  .ov-meta {
    font-family: var(--sans); font-weight: 500;
    font-size: var(--fs-label); letter-spacing: var(--ls-label); text-transform: uppercase;
    color: var(--text-quiet); margin-bottom: 16px;
  }
  .ov-desc {
    font-family: var(--serif); font-weight: 400;
    font-size: var(--fs-body); line-height: 1.5; color: var(--text-quiet);
    margin: 0 0 24px; max-width: 30ch;
  }
  .ov-link {
    font-family: var(--sans); font-weight: 500;
    font-size: var(--fs-label); letter-spacing: var(--ls-label); text-transform: uppercase;
    color: var(--text); padding-bottom: 2px; border-bottom: 1px solid var(--rule);
    transition: color var(--dur-hover) var(--ease-out), border-color var(--dur-hover) var(--ease-out);
  }
  .ov-link:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .ov-hint {
    margin-top: 28px; font-family: var(--sans); font-weight: 500;
    font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-faint);
  }

  /* Scroll cue - bottom centre, fades on first scroll (engine-driven opacity). */
  .cg-cue {
    position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%); z-index: 3;
    font-family: var(--sans); font-weight: 500; font-size: 10px; letter-spacing: 0.34em;
    text-transform: uppercase; color: var(--text); opacity: 0; text-align: center;
    transition: opacity 600ms var(--ease-out); pointer-events: none;
  }
  .cg-cue.in { opacity: 0.5; }
  .cg-arrow { display: block; margin-top: 8px; font-size: 12px; animation: cg-bob 2.4s ease-in-out infinite; }
  @keyframes cg-bob { 0%,100% { transform: translateY(0); opacity:.5 } 50% { transform: translateY(6px); opacity:.95 } }

  /* Beat dots - right edge, progress through the sequence. */
  .cg-beats {
    position: absolute; right: 30px; top: 50%; transform: translateY(-50%); z-index: 3;
    display: flex; flex-direction: column; gap: 11px; align-items: flex-end; pointer-events: none;
  }
  .cg-beats :global(.dot) {
    width: 5px; height: 5px; border-radius: 50%; background: var(--text);
    opacity: 0.2; transition: opacity .35s ease, background .35s ease;
  }
  .cg-beats :global(.dot.on) { opacity: 1; background: var(--accent); }

  /* Stacked layout - JS (fitCamera) adds `.stacked` and lifts the 3D content into
     the upper half when there's no room for the copy beside the glyph; the copy
     then drops to the lower half, full-width. */
  .cg-overlay.stacked .ov-lead,
  .cg-overlay.stacked .ov-product {
    top: 57vh; bottom: auto; transform: none;
    left: var(--outer); right: var(--outer); width: auto; max-width: min(92vw, 40ch);
  }
  /* The scroll cue overlaps the (taller) stacked copy and is least useful on touch
     - drop it on narrow screens; the beat dots already signal there's more below. */
  @media (max-width: 768px) { .cg-cue { display: none; } }

  /* Stacked (mobile) atom: the isotope control + shake hint sit CENTRED below the
     atom form rather than tucked in its corner (engine sets --atom-ctl-top). The
     control becomes a single compact row so it reads as a caption under the viz. */
  .cg-atom-overlay.stacked :global(.atom-control) {
    top: var(--atom-ctl-top, auto); bottom: auto;
    /* Span the full width and centre the row, rather than left:50% (which would
       shrink the box to the right half and wrap the U-235 / U-238 labels). */
    left: 0; right: 0; transform: none;
    flex-direction: row; align-items: center; justify-content: center; gap: 14px;
  }
  /* Keep the isotope labels on one line whatever the layout. */
  .cg-atom-overlay.stacked :global(.atom-switch button) { white-space: nowrap; }
  @media (max-width: 600px) { .cg-beats { right: 16px; } }
  @media (prefers-reduced-motion: reduce) {
    .cg-arrow { animation: none; }
  }
</style>

<script is:inline type="module">
/* eslint-disable */
// ── The scroll-narrative engine - transplanted verbatim from the proven prototype
//    (prototypes/hero/_scroll-narrative.html). Resolves three/addons/lenis via the
//    Layout import map. CONFIG holds every tunable (mirrors the hero's discipline). ──
import * as THREE from 'three';
import { GLTFLoader }     from 'three/addons/loaders/GLTFLoader.js';
import { MeshoptDecoder } from 'three/addons/libs/meshopt_decoder.module.js';
import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
// Postprocessing - used ONLY for the dark theme's bloom; built lazily the first
// time dark is entered so light mode keeps the original direct-render path.
import { EffectComposer }  from 'three/addons/postprocessing/EffectComposer.js';
import { RenderPass }      from 'three/addons/postprocessing/RenderPass.js';
import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
import { OutputPass }      from 'three/addons/postprocessing/OutputPass.js';
import Lenis from 'lenis';

const TAU = Math.PI * 2;
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const isMobile = window.matchMedia('(max-width: 768px)').matches;
// Low-end heuristic - few logical cores OR little RAM. deviceMemory is undefined
// on Safari/Firefox, so it falls back to "capable" (|| 8) and never downgrades a
// desktop browser that simply doesn't report it. On a flagged device we drop the
// particle budget and cap DPR (see renderer.setPixelRatio below); capable hardware
// is untouched, so the look is byte-for-byte identical there. This targets only the
// scroll-fps floor on contended / low-power machines.
const cpuCores = navigator.hardwareConcurrency || 8;
const deviceMem = navigator.deviceMemory || 8;
const lowEnd = cpuCores <= 4 || deviceMem <= 4;

const CONFIG = {
  scene:  { bg: '#FFFFFF', cameraDistance: 15, fov: 32 },
  glyph:  { text: 'CG', worldHeight: 3.1, depth: 0.39, fontWeight: 700 },
  // The nucleus beat - the dust re-forms into the atom (The Nuclear Question),
  // sampled from its SVG contour paths the same way the glyph is sampled from text.
  nucleus: { worldHeight: 3.4, depth: 0.6, pathsUrl: '/nucleus-paths.json' },
  particles: { count: isMobile ? (lowEnd ? 36000 : 55000) : (lowEnd ? 80000 : 140000), baseSize: 0.032, sizeVariance: 0.22, inkColor: '#161616' },
  pointer: { radius: 0.5, strength: 22, smoothing: 0.55 },
  rotation:{ speed: reducedMotion ? 0 : 0.06 },
  loadIn:  { duration: 1.6, stagger: 0.7, startVolume: 7 },
  morph: {
    // disperseRadius is bumped on mobile: the camera sits further back to fit the
    // 3D into the narrow viewport, so a desktop-sized cloud would project as a small
    // central circle. A larger world radius makes the fully-dispersed cloud fill the
    // whole phone screen (as it does on desktop), while still erupting OUT from the
    // model as a growing sphere. Desktop is unchanged.
    shapeRadius: 2.7, disperseRadius: isMobile ? 12.0 : 9.0,
    formIn: 0.12, formOut: 0.38, texAt: 0.62, dividerHeight: 2.4,
  },
  play: { springK: 16, damping: 0.985, maxDisp: 3.0 },
  spin: { speed: 0.0013, maxVel: 0.020, damping: 0.88, returnLerp: 0.06, tilt: 0.5, tiltRange: 0.4 },
  // Scroll is 1:1 with the timeline. sectionVh/modelVh = the SCROLL DISTANCE (in
  // viewport-heights) each transition spans: a gap of `modelVh` takes that many screens
  // of wheel to morph one shape into the next. Kept SHORT so a single comfortable wheel
  // flick completes a transition - otherwise you run out of flick mid-morph, let go, and
  // the snap catches you (the "magnetism takes hold" complaint). The glyph -> nucleus
  // dispersal (sectionVh) MUST be the LONGEST segment, not the shortest: it is a two-phase
  // move (glyph explodes to a full-screen cloud, THEN the cloud reforms into the nucleus),
  // so it travels much further than a flat morph. Too short and the explode + reform flashes
  // by ("way too fast / weird"); it needs ~1.5x a morph so each phase reads.
  // followTau = the morph's own follow time-constant (seconds): the timeline
  // tracks the scroll INTENT with this (small = tight/direct, larger = floatier),
  // independent of Lenis's page-scroll lerp - see readScroll.
  // The snap MUST NOT fight an active scroll: it fires only once the wheel has been
  // quiet for `snapStopMs` AND Lenis momentum has settled (|velocity| < `snapVel`), or,
  // as a fail-safe so a jittery velocity can never strand the dust mid-dispersal, once
  // the wheel has been quiet for `snapStopMsHard`. It then eases OUT to the NEAREST beat
  // (`advanceThresh` ~0.4 = only advance once you are ~40% into a gap). All tunable.
  scroll: { sectionVh: 1.3, modelVh: 0.85, exitVh: 1.6, snapDuration: 0.45, snapStopMs: 320, snapStopMsHard: 650, snapVel: 0.06, snapSettle: 0.0015, advanceThresh: 0.4, followTau: 0.055 },
  modelBase: '/models/',
  // Theme colours for the WebGL surface (the editorial body flips via CSS tokens).
  // Light keeps today's values exactly; dark turns the particles white on a
  // near-black ground and switches on bloom. The bloom values are starting
  // points - tunable.
  theme: {
    light: { bg: '#FFFFFF', ink: '#161616' },
    dark:  { bg: '#0E0E0E', ink: '#FFFFFF' },                 // particles go white on dark
    bloom: { strength: 0.42, radius: 0.35, threshold: 0.84 },
  },
};
// The active theme key, read from <html data-theme> (set pre-paint by Layout).
function themeKey(){ return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'; }

// kind 'glyph'/'text' → particle shape only; 'model' → particles that hand off to a
// textured GLB you can grab and spin. viewRY/viewRX = preferred resting orientation.
const BEATS = [
  { id:'cg',     kind:'glyph', text:'CG' },
  // The flagship beat: the dust re-forms into the live-site atom (rendered as
  // particles, not a GLB - the interactive fission atom lives on the project page).
  { id:'tnq',    kind:'nucleus', name:'The Nuclear Question',  year:2026, disc:'Data Visualisation · Web', slug:'the-nuclear-question', desc:'A thesis on nuclear energy, built as a public data-visualisation platform.' },
  { id:'mantis', kind:'model', name:'Mantis',                  year:2026, disc:'Product Design', slug:'mantis',     desc:'A side table in need of repair, reborn as a standing lamp.',          file:'mantis.glb',     fill:1.0,  viewRY:0.0,  viewRX:0.28 },
  { id:'wave',   kind:'model', name:'Wave',                    year:2026, disc:'Product Design', slug:'wave',       desc:'A salvaged pair of speakers, rebuilt into a custom enclosure.',        file:'speaker.glb',    fill:0.92, viewRY:0.0,  viewRX:0.0  },
  { id:'bg',     kind:'model', name:'Gravity Wave Backgammon', year:2024, disc:'Product Design', slug:'backgammon', desc:'A sheet of recycled ocean plastic turned into a backlit backgammon board.', file:'backgammon.glb', fill:0.92, viewRY:-0.7, viewRX:0.62 },
  { id:'spider', kind:'model', name:'Spider-209',              year:2022, disc:'Product Design', slug:'spider-209', desc:'A classic lamp design reimagined as a desk lamp from materials found on the streets of Madrid.', file:'spider.glb',     fill:0.92, viewRY:0.3,  viewRX:0.15 },
  // Spider is the final beat: it rests at the bottom of the stage, then scrolls straight
  // up into the editorial grid below (which opens with the In short section) - no
  // dispersal interstitial, no blank screen.
];
const N = BEATS.length;
const MODEL_COUNT = BEATS.filter(b=>b.kind==='model').length;
// Featured beats = the products shown with overlay copy (the GLB models + the
// nucleus). Drives the "NN / NN" index and the beat dots.
const FEATURED_COUNT = BEATS.filter(b=>b.kind==='model' || b.kind==='nucleus').length;
const NUCLEUS_BEAT = BEATS.findIndex(b=>b.kind==='nucleus');
const COUNT = CONFIG.particles.count;

// A full-screen DISPERSAL belongs only at a SECTION boundary - either side of a
// structural beat (the CG glyph, or a text/disperse divider). Everything WITHIN the
// "selected work" run - the nucleus AND the GLB models alike - morphs DIRECTLY into the
// next (the dust shape-shifts from one to the next). So glyph → nucleus still explodes,
// but nucleus → Mantis is now a subtle morph, matching the model → model hand-offs,
// rather than the screen-filling dispersal it used to be.
const isStructural = (k)=> k==='glyph' || k==='text' || k==='disperse';
const GAP_DISPERSE = [];
for(let i=0;i<N-1;i++) GAP_DISPERSE[i] = isStructural(BEATS[i].kind) || isStructural(BEATS[i+1].kind);
// Per-gap scroll length (vh): section dispersals span more scroll than model morphs.
const GAP_VH = [];
for(let i=0;i<N-1;i++) GAP_VH[i] = GAP_DISPERSE[i] ? CONFIG.scroll.sectionVh : CONFIG.scroll.modelVh;
// Legacy exit-length override: only applied if the last beat were a `text`/`disperse`
// divider. The current narrative ends on a `model` (Spider-209) that scrolls straight
// into the editorial body, so this branch is dormant (kept in case a closing divider
// beat is reintroduced; `CONFIG.scroll.exitVh` + `morph.dividerHeight` are likewise
// vestigial until then).
if(BEATS[N-1].kind === 'text' || BEATS[N-1].kind === 'disperse') GAP_VH[N-2] = CONFIG.scroll.exitVh;
const TOTAL_VH = GAP_VH.reduce((a,b)=>a+b,0);
const STOP_F = [0];
for(let i=0;i<N-1;i++) STOP_F[i+1] = STOP_F[i] + GAP_VH[i]/TOTAL_VH;

// ── Samplers - every target is exactly COUNT points, index-aligned (so any two lerp). ──
function seededRNG(seed){ let s = seed>>>0; return ()=> (s = (Math.imul(1664525,s)+1013904223)>>>0)/4294967296; }
function smootherstep(e0,e1,x){ let t=(x-e0)/(e1-e0); t=t<0?0:t>1?1:t; return t*t*t*(t*(t*6-15)+10); }
// Ease-OUT (cubic): immediate start, decelerate into the target. Used for the snap so
// an on-stop settle starts moving at once rather than holding-then-surging the way the
// quintic ease-in-out (smootherstep) does (zero velocity at x=0).
function easeOutCubic(x){ x = x<0?0:x>1?1:x; return 1 - Math.pow(1-x, 3); }
const clamp=(v,a,b)=>v<a?a:v>b?b:v;

function sampleText(text, count, { worldHeight, depth=0.4, weight=700, seed=11 }){
  const lines = String(text).split('\n');
  const W = 1600, H = Math.round(W * (lines.length>1 ? 0.62 : 0.5));
  const cv = document.createElement('canvas'); cv.width=W; cv.height=H;
  const ctx = cv.getContext('2d', { willReadFrequently:true });
  ctx.fillStyle = '#fff'; ctx.fillRect(0,0,W,H);
  ctx.fillStyle = '#000'; ctx.textAlign='center'; ctx.textBaseline='middle';
  let fs = Math.floor(H / (lines.length + 0.25));
  ctx.font = `${weight} ${fs}px "Playfair Display", Georgia, serif`;
  let maxw = 0; for (const l of lines) maxw = Math.max(maxw, ctx.measureText(l).width);
  if (maxw > W*0.92){ fs = Math.floor(fs * (W*0.92)/maxw); ctx.font = `${weight} ${fs}px "Playfair Display", Georgia, serif`; }
  const lh = fs * 1.04;
  const y0 = H/2 - lh*(lines.length-1)/2;
  lines.forEach((l,i)=> ctx.fillText(l, W/2, y0 + i*lh));
  const data = ctx.getImageData(0,0,W,H).data;
  const pool = [];
  let minX=W,minY=H,maxX=0,maxY=0;
  for (let y=0;y<H;y++) for (let x=0;x<W;x++){
    if (data[(y*W+x)*4] < 100){ pool.push(x,y); if(x<minX)minX=x; if(x>maxX)maxX=x; if(y<minY)minY=y; if(y>maxY)maxY=y; }
  }
  const cx=(minX+maxX)/2, cy=(minY+maxY)/2, span=(maxY-minY)||1;
  const scale = worldHeight / span;
  const rng = seededRNG(seed), jr = seededRNG(seed*7+1);
  const out = new Float32Array(count*3);
  const M2 = pool.length/2;
  for (let i=0;i<count;i++){
    const k = (Math.floor(rng()*M2))*2;
    out[i*3]   =  (pool[k]   - cx) * scale + (jr()-0.5)*0.02;
    out[i*3+1] = -(pool[k+1] - cy) * scale + (jr()-0.5)*0.02;
    out[i*3+2] =  (jr()-0.5) * depth;
  }
  return out;
}
// Rasterise the atom's SVG contour paths and sample dark pixels into particle
// positions - identical technique to sampleText (draw → getImageData → sample),
// so the dust re-forms into the nucleus. The paths live in a ~1190² icon viewBox.
function sampleNucleus(paths, count, { worldHeight, depth=0.5, seed=23 }){
  const S = 1191;
  const cv = document.createElement('canvas'); cv.width=S; cv.height=S;
  const ctx = cv.getContext('2d', { willReadFrequently:true });
  ctx.fillStyle='#fff'; ctx.fillRect(0,0,S,S);
  ctx.strokeStyle='#000'; ctx.lineWidth=3; ctx.lineJoin='round'; ctx.lineCap='round';
  for(const d of paths){ try{ ctx.stroke(new Path2D(d)); }catch(e){} }
  const data = ctx.getImageData(0,0,S,S).data;
  const pool=[]; let minX=S,minY=S,maxX=0,maxY=0;
  for(let y=0;y<S;y++) for(let x=0;x<S;x++){
    if(data[(y*S+x)*4] < 100){ pool.push(x,y); if(x<minX)minX=x; if(x>maxX)maxX=x; if(y<minY)minY=y; if(y>maxY)maxY=y; }
  }
  if(!pool.length) return DISPERSE;
  const cx=(minX+maxX)/2, cy=(minY+maxY)/2, span=(maxY-minY)||1;
  const scale = worldHeight/span;
  const rng=seededRNG(seed), jr=seededRNG(seed*7+1);
  const out=new Float32Array(count*3); const M2=pool.length/2;
  for(let i=0;i<count;i++){
    const k=(Math.floor(rng()*M2))*2;
    out[i*3]   =  (pool[k]  -cx)*scale + (jr()-0.5)*0.02;
    out[i*3+1] = -(pool[k+1]-cy)*scale + (jr()-0.5)*0.02;
    out[i*3+2] =  (jr()-0.5)*depth;
  }
  return out;
}
function sampleDisperse(count, radius, seed=99){
  const rng = seededRNG(seed);
  const out = new Float32Array(count*3);
  for (let i=0;i<count;i++){
    const u=rng(), v=rng(), w=rng();
    const theta=Math.acos(1-2*u), phi=TAU*v, r=radius*(0.55+0.45*Math.cbrt(w));
    out[i*3]   = r*Math.sin(theta)*Math.cos(phi);
    out[i*3+1] = r*Math.sin(theta)*Math.sin(phi);
    out[i*3+2] = r*Math.cos(theta);
  }
  return out;
}
function computeFit(scene, fill=1){
  scene.updateMatrixWorld(true);
  const box = new THREE.Box3().setFromObject(scene);
  const sphere = box.getBoundingSphere(new THREE.Sphere());
  const scale = (CONFIG.morph.shapeRadius * fill) / (sphere.radius || 1);
  return { center: sphere.center.clone(), scale };
}
function sampleMesh(scene, count, fit, seed=17){
  scene.updateMatrixWorld(true);
  const tris=[], areas=[]; const tmp = new THREE.Triangle();
  scene.traverse(o=>{
    if(!o.isMesh) return;
    const g=o.geometry, pos=g.attributes.position, idx=g.index, m=o.matrixWorld;
    const V=(i)=> new THREE.Vector3().fromBufferAttribute(pos,i).applyMatrix4(m);
    const push=(a,b,c)=>{ const A=V(a),B=V(b),C=V(c); tmp.set(A,B,C); const ar=tmp.getArea(); if(ar>1e-10){ tris.push([A,B,C]); areas.push(ar);} };
    if(idx){ for(let i=0;i<idx.count-2;i+=3) push(idx.getX(i),idx.getX(i+1),idx.getX(i+2)); }
    else   { for(let i=0;i<pos.count-2;i+=3) push(i,i+1,i+2); }
  });
  const out = new Float32Array(count*3);
  if(!tris.length) return sampleDisperse(count, CONFIG.morph.shapeRadius, seed);
  const total = areas.reduce((a,b)=>a+b,0);
  const cdf=[]; let acc=0; for(const a of areas){ acc+=a/total; cdf.push(acc); }
  const rng = seededRNG(seed); const { center, scale } = fit;
  for(let i=0;i<count;i++){
    const r=rng(); let lo=0,hi=cdf.length-1; while(lo<hi){ const mid=(lo+hi)>>1; cdf[mid]<r?lo=mid+1:hi=mid; }
    const [a,b,c]=tris[lo];
    let u=rng(), v=rng(); if(u+v>1){ u=1-u; v=1-v; } const w=1-u-v;
    out[i*3]   = ((a.x*w + b.x*u + c.x*v) - center.x) * scale;
    out[i*3+1] = ((a.y*w + b.y*u + c.y*v) - center.y) * scale;
    out[i*3+2] = ((a.z*w + b.z*u + c.z*v) - center.z) * scale;
  }
  return out;
}

// ── Particle system - the hero's shader, morph-friendly buffers. ──
const VERT = `
  attribute float aSizeMul;
  uniform float uBaseSize; uniform float uSizeScale; uniform float uDisperse;
  void main(){
    vec4 mv = modelViewMatrix * vec4(position,1.0);
    // While the dust is in a screen-filling DISPERSAL (uDisperse->1) it covers the whole
    // viewport - the heaviest overdraw / fill-rate moment on a retina/ProMotion display.
    // The particles are spread thin then, so a slightly smaller point reads the same
    // density but cuts fill-rate by ~point-size squared. uDisperse is 0 when the dust is
    // formed (glyph/models) and during the compact model->model morphs, so those stay
    // crisp and byte-for-byte unchanged.
    float shrink = mix(1.0, 0.84, uDisperse);
    gl_PointSize = uBaseSize * aSizeMul * shrink * (uSizeScale / -mv.z);
    gl_Position = projectionMatrix * mv;
  }`;
const FRAG = `
  precision highp float;
  uniform vec3 uInk; uniform float uOpacity;
  void main(){
    vec2 c = gl_PointCoord - 0.5; float r = length(c)*2.0;
    if (r >= 1.0) discard;
    float a = smoothstep(1.0, 0.25, r);
    gl_FragColor = vec4(uInk, a * uOpacity);
  }`;
class Particles {
  constructor(){
    const positions = new Float32Array(COUNT*3);
    const sizeMul   = new Float32Array(COUNT);
    this.home = new Float32Array(COUNT*3);
    this.vel  = new Float32Array(COUNT*3);
    this.disp = new Float32Array(COUNT*3);
    const sv = CONFIG.particles.sizeVariance;
    for(let i=0;i<COUNT;i++) sizeMul[i] = 1 + (Math.random()-0.5)*sv;
    this.geometry = new THREE.BufferGeometry();
    this.geometry.setAttribute('position', new THREE.BufferAttribute(positions,3));
    this.geometry.setAttribute('aSizeMul', new THREE.BufferAttribute(sizeMul,1));
    this.material = new THREE.ShaderMaterial({
      uniforms:{ uBaseSize:{value:CONFIG.particles.baseSize}, uSizeScale:{value:1}, uDisperse:{value:0},
                 uInk:{value:new THREE.Color(CONFIG.theme[themeKey()].ink)}, uOpacity:{value:1} },
      vertexShader:VERT, fragmentShader:FRAG,
      transparent:true, depthWrite:false, depthTest:false, blending:THREE.NormalBlending,
    });
    this.points = new THREE.Points(this.geometry, this.material);
    this.points.frustumCulled = false;
  }
}

// Resolve the timeline → which two targets blend, the eased blend e, and formW (how
// fully the nearest stop's actual geometry is built). formW drives dust + texture.
const M = { FROM:null, TO:null, e:0, formW:1 };
function resolveMorph(p){
  let i=Math.floor(p); if(i<0)i=0; if(i>N-2)i=N-2;
  const frac=p-i, A=targets[i]||DISPERSE, B=targets[i+1]||DISPERSE;
  let FROM, TO, e;
  if(GAP_DISPERSE[i]){
    if(frac<0.5){ FROM=A; TO=DISPERSE; e=smootherstep(0,1,frac*2); }
    else        { FROM=DISPERSE; TO=B; e=smootherstep(0,1,(frac-0.5)*2); }
  } else { FROM=A; TO=B; e=smootherstep(0,1,frac); }
  M.FROM=FROM; M.TO=TO; M.e=e;
  M.formW = frac<0.5 ? (1-e) : e;
}

// One pass: position = direct morph target + spring-play displacement (pointer repel).
function stepParticles(dt, probe){
  const pos=ps.geometry.attributes.position.array, vel=ps.vel, disp=ps.disp;
  const FROM=M.FROM, TO=M.TO, e=M.e, ie=1-e;
  const P=CONFIG.play, k=P.springK, dmp=P.damping, maxD=P.maxDisp, maxD2=maxD*maxD;
  const on=probe.active, ox=probe.o.x,oy=probe.o.y,oz=probe.o.z, rx=probe.d.x,ry=probe.d.y,rz=probe.d.z;
  const pr=CONFIG.pointer.radius, pr2=pr*pr, str=CONFIG.pointer.strength;
  for(let n=0;n<COUNT;n++){
    const j=n*3;
    const tx=FROM[j]*ie+TO[j]*e, ty=FROM[j+1]*ie+TO[j+1]*e, tz=FROM[j+2]*ie+TO[j+2]*e;
    let dx=disp[j], dy=disp[j+1], dz=disp[j+2];
    let fx=-k*dx, fy=-k*dy, fz=-k*dz;
    if(on){
      const wx=tx+dx-ox, wy=ty+dy-oy, wz=tz+dz-oz;
      const proj=wx*rx+wy*ry+wz*rz, ex=wx-proj*rx, ey=wy-proj*ry, ez=wz-proj*rz;
      const d2=ex*ex+ey*ey+ez*ez;
      if(d2<pr2){ const d=Math.sqrt(d2)||1e-4, u=1-d/pr, sm=u*u*(3-2*u), mag=str*sm/d; fx+=ex*mag; fy+=ey*mag; fz+=ez*mag; }
    }
    let vx=(vel[j]+fx*dt)*dmp, vy=(vel[j+1]+fy*dt)*dmp, vz=(vel[j+2]+fz*dt)*dmp;
    vel[j]=vx; vel[j+1]=vy; vel[j+2]=vz;
    dx+=vx*dt; dy+=vy*dt; dz+=vz*dt;
    const dd2=dx*dx+dy*dy+dz*dz; if(dd2>maxD2){ const s=maxD/Math.sqrt(dd2); dx*=s; dy*=s; dz*=s; }
    disp[j]=dx; disp[j+1]=dy; disp[j+2]=dz;
    pos[j]=tx+dx; pos[j+1]=ty+dy; pos[j+2]=tz+dz;
  }
  ps.geometry.attributes.position.needsUpdate=true;
}

// ── THREE setup ──
const canvas = document.getElementById('c');
// The live-atom overlay (the TNQ beat). fitCamera positions it over the model
// region; the frame loop drives its opacity. Sized to ~match the dust nucleus.
const atomOverlay = document.getElementById('atomOverlay');

// Graceful degradation when WebGL is unavailable or its context is lost: hide the dead
// canvas, reveal the static CG monogram + the intro copy (the engine normally fades the
// copy in per beat, so we must show it here), let the nav in, and pause the atom island.
// The crawlable project links + h1 in the sr-only block are unaffected, so content/SEO
// survive. We do not attempt full context restoration (complex) - the monogram is enough.
function showHeroFallback(){
  const fb = document.getElementById('cgFallback'); if(fb) fb.classList.add('show');
  if(canvas) canvas.style.display = 'none';
  const lead = document.querySelector('.ov-lead'); if(lead) lead.style.opacity = '1';
  const navEl = document.querySelector('.site-nav'); if(navEl) navEl.classList.add('in');
  const cue = document.getElementById('scrollCue'); if(cue) cue.style.display = 'none';
  window.__cgAtomActive = false;
  try { window.dispatchEvent(new CustomEvent('atom:active', { detail:{ active:false } })); } catch(e){}
  try { window.dispatchEvent(new CustomEvent('hero:loaded')); } catch(e){}
}

let renderer;
try {
  renderer = new THREE.WebGLRenderer({ canvas, antialias:true, alpha:false });
} catch(err){
  showHeroFallback();
  throw err;   // WebGL is required for everything below - abort the engine cleanly
}
// If the GPU drops the context later, fall back rather than freeze on a blank canvas.
canvas.addEventListener('webglcontextlost', (e)=>{ e.preventDefault(); visible = false; showHeroFallback(); }, false);
renderer.setPixelRatio(Math.min(lowEnd ? 1.5 : 2, window.devicePixelRatio));
renderer.setSize(innerWidth, innerHeight, false);
renderer.setClearColor(new THREE.Color(CONFIG.theme[themeKey()].bg));
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.toneMapping = THREE.ACESFilmicToneMapping;

const scene = new THREE.Scene();
scene.background = new THREE.Color(CONFIG.theme[themeKey()].bg);
const camera = new THREE.PerspectiveCamera(CONFIG.scene.fov, innerWidth/innerHeight, 0.1, 100);
camera.position.set(0,0,CONFIG.scene.cameraDistance);

// Dolly the camera to the viewport WIDTH so the whole composition (glyph + every
// product model) scales down on narrower screens. The copy columns are a fixed
// text width, so they take a larger share as the viewport narrows; scaling the 3D
// down in step keeps the wide-screen proportions and stops the centred glyph from
// growing into the left-hand copy. Reference is the wide layout the hero was tuned
// at; clamped so it never zooms in past that (≥ref → 1), nor so far back the glyph
// is lost. Pure projection change - the morph/snap/fit maths are all world-space.
// Lay the hero out so the copy stays on the LEFT and the glyph/models never
// overlap it at ANY window shape. We frame the 3D content into the free region to
// the RIGHT of the copy column: dolly so it fits that region (width AND height, so
// a tall/near-square window can't make it spread sideways into the copy) and
// offset the camera so it's centred there. When the viewport is too narrow for a
// beside layout, STACK instead - content lifts into the upper half, the copy drops
// below (CSS reacts to the `.stacked` class). Pure camera move/scale; the morph/
// snap/fit maths are world-space and untouched. The copy-column width here mirrors
// the CSS (`min(520px, 36vw)`) so the two always agree.
const HW = CONFIG.morph.shapeRadius;   // worst-case content half-extent (a model's bounding sphere)
function fitCamera(){
  const W = innerWidth, H = innerHeight;
  const tanV = Math.tan(THREE.MathUtils.degToRad(CONFIG.scene.fov) / 2);
  const outer  = Math.max(W <= 768 ? 24 : 36, 0.05 * W);
  const copyW  = Math.min(520, 0.36 * W);
  const gutter = Math.max(56, 0.04 * W);
  const regionL = outer + copyW + gutter;          // left edge of the glyph's region
  const regionR = W - Math.max(outer, 72);         // keep clear of the beat dots
  const regionW = regionR - regionL;
  const stacked = regionW < 360;                   // no room beside the copy → stack
  let D, x, y, cx, cy;
  if (!stacked) {
    const fit = 0.86;
    const Dw = HW * H / (tanV * fit * regionW);     // distance to fit content WIDTH into the region
    const Dh = HW / (tanV * fit);                   // …and to fit its HEIGHT into the viewport
    D = Math.max(CONFIG.scene.cameraDistance, Dw, Dh);
    const visW = 2 * D * tanV * (W / H);
    // Prefer the TRUE screen centre: on a wide / fullscreen desktop the glyph and the
    // product models sit dead-centre, where they read best. Only when a centred glyph
    // would crowd the left-hand copy (narrower desktops) do we slide it right by the
    // minimum needed to clear the copy - so the copy is never overlapped, but the 3D
    // is no longer pinned to the right of an empty middle.
    const halfPx = HW * H / (2 * D * tanV);         // content's on-screen half-width (px)
    const copyRight = outer + copyW;                // right edge of the copy column
    const minGap = Math.max(48, 0.025 * W);         // breathing room between copy and glyph
    let cxPx = W / 2;                               // aim: centre of the screen
    if (cxPx - halfPx < copyRight + minGap) cxPx = copyRight + minGap + halfPx;
    cxPx = Math.min(cxPx, regionR - halfPx);        // never let it run under the beat dots
    x = -((cxPx - W / 2) / W) * visW;
    y = 0;
    cx = cxPx; cy = H / 2;
  } else {
    // Mobile / narrow: stack the 3D ABOVE the copy. Fill most of the WIDTH (the
    // narrow axis) so the glyph + models read large - the desktop-only 0.42 fit
    // left them tiny - but cap the HEIGHT so the content stays in the upper region
    // with room for the copy (and, on the nucleus beat, the isotope control) below.
    const fillW = 0.82, fillH = 0.52;
    D = Math.max(CONFIG.scene.cameraDistance, HW * H / (tanV * fillW * W), HW / (tanV * fillH));
    x = 0;
    cx = W / 2; cy = 0.30 * H;                       // upper third, clear of the fixed nav
    y = ((cy - H / 2) / H) * (2 * D * tanV);         // lift content so it centres on cy
  }
  camera.position.set(x, y, D);
  const ovl = document.querySelector('.cg-overlay');
  if (ovl) ovl.classList.toggle('stacked', stacked);
  // The overlay is full-screen; tell the atom where to draw its FORM (the model
  // region) via CSS vars. half = on-screen half-extent of a worst-case bounding
  // sphere (HW projected); the form field radius ~matches the dust nucleus it
  // crossfades from. Controls/hint anchor to the form box, not the screen corner.
  if (atomOverlay) {
    atomOverlay.classList.toggle('stacked', stacked);
    const half = HW * H / (2 * D * tanV);
    const formR = 0.95 * half;
    atomOverlay.style.setProperty('--form-cx', cx + 'px');
    atomOverlay.style.setProperty('--form-cy', cy + 'px');
    atomOverlay.style.setProperty('--form-r', formR + 'px');
    // Publish the form region to a JS channel too (mirrors __cgAtomActive /
    // atom:active). The island's hot loop would otherwise have to poll these
    // CSS vars with getComputedStyle every frame - a forced style recalc per
    // frame on the input-to-paint path. The CSS vars stay: they still anchor
    // the isotope control + hint below.
    window.__cgFormRegion = { cx, cy, r: formR };
    dispatchEvent(new CustomEvent('atom:formregion', { detail: window.__cgFormRegion }));
    if (stacked) {
      // Narrow screen: the wide isotope pill can't sit in the form box's corner
      // without covering the visualisation, so stack the control + hint CENTRED
      // directly below the atom (CSS reads --atom-ctl-top in the .stacked rule).
      atomOverlay.style.setProperty('--atom-ctl-top', (cy + formR + 12) + 'px');
      atomOverlay.style.setProperty('--atom-hint-x', cx + 'px');
      atomOverlay.style.setProperty('--atom-hint-y', (cy + formR + 66) + 'px');
    } else {
      // Wide screen: isotope control anchored to the form box's BOTTOM-RIGHT corner
      // - in the square box's corner dead-space, clear of the circular form even as
      // it bulges toward the cursor. (right/bottom = distance from the viewport edges.)
      atomOverlay.style.setProperty('--atom-ctl-right', (W - (cx + formR)) + 'px');
      atomOverlay.style.setProperty('--atom-ctl-bottom', (H - (cy + formR)) + 'px');
      // Shake hint centred just below the form box - below the toggle's row, so the
      // two never overlap while the U-238 hint is showing.
      atomOverlay.style.setProperty('--atom-hint-x', cx + 'px');
      atomOverlay.style.setProperty('--atom-hint-y', (cy + formR + 16) + 'px');
    }
  }
}
fitCamera();

const pmrem = new THREE.PMREMGenerator(renderer);
scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
const key = new THREE.DirectionalLight(0xffffff, 1.1); key.position.set(2,3,2); scene.add(key);
const fillL = new THREE.DirectionalLight(0xffffff, 0.35); fillL.position.set(-2,0.5,-1.5); scene.add(fillL);

const cloudGroup = new THREE.Group(); cloudGroup.rotation.order='YXZ'; scene.add(cloudGroup);
const ps = new Particles();
cloudGroup.add(ps.points);

function sizeScale(){ const t=new THREE.Vector2(); renderer.getDrawingBufferSize(t); ps.material.uniforms.uSizeScale.value = t.y*0.5; }
sizeScale();

// ── Theme: particle/ground colour + dark-only bloom ─────────────────────────
// Light mode keeps the original direct renderer.render path EXACTLY untouched -
// no composer is ever constructed. Only when dark mode is first entered do we
// lazily build the EffectComposer chain and use it while `useBloom` is true.
// The particle MOTION/density/behaviour is identical in both themes - only the
// ink colour and this bloom differ.
let useBloom = false;
let composer = null, bloomPass = null;
function buildComposer(){
  composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  const b = CONFIG.theme.bloom;
  // Global bloom. threshold 0.75 is meant to bloom the bright white particles but
  // mostly spare the mid-tone textured GLB models sharing the scene. If the lit
  // models glow undesirably, the escalation path is SELECTIVE bloom via layers
  // (put ps.points on a dedicated bloom layer, render the models on a separate
  // pass excluded from it). Try the simple global pass first.
  bloomPass = new UnrealBloomPass(new THREE.Vector2(innerWidth, innerHeight), b.strength, b.radius, b.threshold);
  composer.addPass(bloomPass);
  // OutputPass does ACES tone-mapping + sRGB at the end of the chain - needed
  // because the composer path bypasses the renderer's built-in output conversion.
  composer.addPass(new OutputPass());
  composer.setPixelRatio(renderer.getPixelRatio());
  composer.setSize(innerWidth, innerHeight);
}
function applyTheme(key){
  const c = CONFIG.theme[key] || CONFIG.theme.light;
  renderer.setClearColor(new THREE.Color(c.bg));
  scene.background.set(c.bg);
  ps.material.uniforms.uInk.value.set(c.ink);
  useBloom = (key === 'dark');
  if(useBloom && !composer) buildComposer();   // built once, on first dark entry
}
applyTheme(themeKey());
// The toggle (Nav.astro) dispatches `theme:change` - mirrors the `hero:loaded`
// contract, keeps the toggle and the engine decoupled.
addEventListener('theme:change', (e)=> applyTheme((e.detail && e.detail.theme) || themeKey()));

// ── Adaptive resolution ─────────────────────────────────────────────────────
// The look-preserving version of the low-end cap. The static core/RAM heuristic
// (lowEnd) can't see a weak GPU - and the heaviest path here is fill-rate (140k
// translucent points + dark-mode bloom, both at DPR 2 over a full-screen canvas).
// So we also adapt at RUNTIME: a device that holds the frame budget renders at full
// DPR exactly as before (capable hardware is untouched); a device that can't keep up
// steps the hero's pixel ratio down instead of dropping frames. The renderer AND the
// bloom composer share the ratio, so dark mode gets cheaper too. Step DOWN only, and
// only after a sustained slow run (not a one-off model-upload spike), so it settles
// rather than oscillates.
const baseDPR = Math.min(lowEnd ? 1.5 : 2, window.devicePixelRatio);
const DPR_FLOOR = 1.0;
let curDPR = baseDPR, slowRun = 0;
function applyDPR(r){
  renderer.setPixelRatio(r); renderer.setSize(innerWidth, innerHeight, false); sizeScale();
  if(composer){ composer.setPixelRatio(r); composer.setSize(innerWidth, innerHeight); }
}
// Estimate the display's frame budget so the jank threshold scales to the refresh rate.
// A 26ms (sub-40fps) threshold is right for 60Hz but far too lax for a 120Hz ProMotion
// panel, where 16.7ms is already a dropped frame. Sampled once from the first stable
// frames (median ~8.3ms => high refresh). We still only step DOWN after a sustained run,
// so a brief dispersal spike never downscales the crisp hero - only a genuinely weak GPU
// holding sub-60fps does.
let refreshHz = 60, refreshSampled = false; const refreshSamples = [];
function estimateRefresh(dtMs){
  if(refreshSampled) return;
  refreshSamples.push(dtMs);
  if(refreshSamples.length >= 50){
    const s = refreshSamples.slice(10).sort((a,b)=>a-b);
    refreshHz = (s[s.length>>1] || 16.7) < 11 ? 120 : 60;
    refreshSampled = true;
  }
}
function adaptQuality(frameMs){
  if(!refreshSampled) estimateRefresh(frameMs);
  // 120Hz: a sustained run below 60fps (>16.7ms) steps down; 60Hz: below 40fps (>26ms),
  // as before. ~24 consecutive slow frames (~0.4s) are still required, so a one-off
  // GLB-upload / lazy-composer hitch or the brief dispersal never trips it.
  const slowMs = refreshHz >= 120 ? 16.7 : 26;
  if(frameMs > slowMs){
    if(++slowRun >= 24 && curDPR > DPR_FLOOR){ curDPR = Math.max(DPR_FLOOR, curDPR - 0.5); applyDPR(curDPR); slowRun = 0; }
  } else slowRun = 0;
}

// ── Targets: text/glyph/disperse up front; models async. ──
const DISPERSE = sampleDisperse(COUNT, CONFIG.morph.disperseRadius);
const targets = new Array(N).fill(null);
const models  = new Array(N).fill(null);
const gltfLoader = new GLTFLoader().setMeshoptDecoder(MeshoptDecoder);

async function fontReady(){ try{ await document.fonts.load('700 96px "Playfair Display"'); await document.fonts.ready; }catch(e){} }
function buildTextTargets(){
  for(let i=0;i<N;i++){
    const b=BEATS[i];
    if(b.kind==='glyph') targets[i]=sampleText(b.text, COUNT, { worldHeight:CONFIG.glyph.worldHeight, depth:CONFIG.glyph.depth, weight:700, seed:42 });
    else if(b.kind==='text') targets[i]=sampleText(b.text, COUNT, { worldHeight:CONFIG.morph.dividerHeight, depth:0.3, weight:700, seed:7 });
    else if(b.kind==='disperse') targets[i]=DISPERSE;   // dissolves into the enveloping cloud
  }
}
// Fetch the atom's contour paths (served static, homepage-only - kept out of the
// HTML) and build the nucleus particle target. Until it resolves the beat falls
// back to DISPERSE, exactly like an unloaded model.
async function loadNucleus(i){
  try{
    const res = await fetch(CONFIG.nucleus.pathsUrl);
    const paths = await res.json();
    targets[i] = sampleNucleus(paths, COUNT, { worldHeight:CONFIG.nucleus.worldHeight, depth:CONFIG.nucleus.depth, seed:23 });
  }catch(e){ console.warn('[ScrollHero] nucleus load failed', e); }
}
function loadModel(i){
  const b=BEATS[i]; if(b.kind!=='model') return Promise.resolve();
  return new Promise((res)=>{
    gltfLoader.load(CONFIG.modelBase+b.file, (gltf)=>{
      const src = gltf.scene;
      const fit = computeFit(src, b.fill||1);
      targets[i] = sampleMesh(src, COUNT, fit, 17+i);
      const maxAniso = renderer.capabilities.getMaxAnisotropy();
      const obj = src.clone(true);
      const mats=[];
      obj.traverse(n=>{
        if(!n.isMesh) return;
        if(!n.geometry.attributes.normal) n.geometry.computeVertexNormals();
        n.material = n.material.clone();
        n.material.transparent = true; n.material.opacity = 0; n.material.depthWrite = false;
        if(n.material.map){ n.material.map.colorSpace=THREE.SRGBColorSpace; n.material.map.anisotropy=maxAniso; }
        mats.push(n.material);
      });
      const inner = new THREE.Group(); inner.position.copy(fit.center).multiplyScalar(-1); inner.add(obj);
      const outer = new THREE.Group(); outer.scale.setScalar(fit.scale); outer.add(inner);
      outer.visible = false; outer.rotation.order = 'YXZ';
      scene.add(outer);
      models[i] = { group: outer, materials: mats, solid:null };
      res();
    }, undefined, (err)=>{ console.warn('[ScrollHero] model load failed', b.file, err); res(); });
  });
}

// ── Load-in: particles assemble into CG (plays once), then nav fades in. ──
let loadIn = null;
function startLoadIn(){
  const starts=new Float32Array(COUNT*3), delays=new Float32Array(COUNT);
  const cg = targets[0]; const vol=CONFIG.loadIn.startVolume;
  let minX=Infinity,maxX=-Infinity; for(let i=0;i<COUNT;i++){ const x=cg[i*3]; if(x<minX)minX=x; if(x>maxX)maxX=x; }
  const xr=(maxX-minX)||1;
  for(let i=0;i<COUNT;i++){ const i3=i*3;
    starts[i3]=(Math.random()-0.5)*vol; starts[i3+1]=(Math.random()-0.5)*vol; starts[i3+2]=(Math.random()-0.5)*vol*0.5;
    delays[i]=((cg[i3]-minX)/xr)*CONFIG.loadIn.stagger;
  }
  const pos=ps.geometry.attributes.position.array; pos.set(starts); ps.geometry.attributes.position.needsUpdate=true;
  ps.vel.fill(0);
  loadIn = { t0: clock.elapsedTime, starts, delays, done:false };
}
function stepLoadIn(time){
  const dur=CONFIG.loadIn.duration, total=dur+CONFIG.loadIn.stagger, t=time-loadIn.t0;
  const cg=targets[0], pos=ps.geometry.attributes.position.array, st=loadIn.starts, dl=loadIn.delays;
  const ease=(x)=>1-Math.pow(1-x,3);
  for(let i=0;i<COUNT;i++){ const i3=i*3; const lt=(t-dl[i])/dur; const u=lt<=0?0:lt>=1?1:ease(lt); const inv=1-u;
    pos[i3]=st[i3]*inv+cg[i3]*u; pos[i3+1]=st[i3+1]*inv+cg[i3+1]*u; pos[i3+2]=st[i3+2]*inv+cg[i3+2]*u; }
  ps.geometry.attributes.position.needsUpdate=true;
  if(t>=total){
    loadIn.done=true; ps.home.set(cg); pos.set(cg); ps.vel.fill(0);
    scrollCue.classList.add('in');
    const navEl = document.querySelector('.site-nav'); if(navEl) navEl.classList.add('in');
    window.dispatchEvent(new CustomEvent('hero:loaded'));
  }
}

// ── Pointer: repel probe (cloud) OR drag-spin (settled model). ──
const probe = { active:false, o:new THREE.Vector3(1e6,1e6,1e6), d:new THREE.Vector3(0,0,-1),
  ndc:new THREE.Vector2(), sm:new THREE.Vector2(), snap:false, ray:new THREE.Raycaster(), inv:new THREE.Matrix4() };
function probeSet(x,y){ probe.ndc.set(x,y); if(!probe.active){ probe.snap=true; } probe.active=true; }
function probeUpdate(){
  if(!probe.active) return;
  if(probe.snap){ probe.sm.copy(probe.ndc); probe.snap=false; } else probe.sm.lerp(probe.ndc, CONFIG.pointer.smoothing);
  probe.ray.setFromCamera(probe.sm, camera);
  probe.inv.copy(cloudGroup.matrixWorld).invert();
  probe.o.copy(probe.ray.ray.origin).applyMatrix4(probe.inv);
  probe.d.copy(probe.ray.ray.direction).transformDirection(probe.inv);
}
let drag = { on:false, lastX:0, lastY:0 };
canvas.style.pointerEvents = 'auto';
let dragSpin=0, dragSpinVel=0, dragTilt=0;
function activeModelBeat(){
  if (state.shapeW < 0.85) return -1;
  const b = state.center;
  // Only GLB models are drag-to-spin. The nucleus beat hands off to the live atom
  // overlay, which owns its own interaction, so the dust itself isn't grabbable.
  return BEATS[b] && BEATS[b].kind==='model' && models[b] ? b : -1;
}
addEventListener('pointermove', (e)=>{
  const x=(e.clientX/innerWidth)*2-1, y=-(e.clientY/innerHeight)*2+1;
  if(drag.on){
    const S=CONFIG.spin;
    dragSpinVel = clamp(dragSpinVel + (e.clientX-drag.lastX)*S.speed, -S.maxVel, S.maxVel);
    dragTilt    = clamp(dragTilt    + (e.clientY-drag.lastY)*S.speed*S.tilt, -S.tiltRange, S.tiltRange);
    drag.lastX=e.clientX; drag.lastY=e.clientY;
  } else { probeSet(x,y); }
});
canvas.addEventListener('pointerdown', (e)=>{
  if(activeModelBeat()>=0){ drag.on=true; drag.lastX=e.clientX; drag.lastY=e.clientY; canvas.classList.add('grabbing'); probe.active=false; }
});
addEventListener('pointerup', ()=>{ drag.on=false; canvas.classList.remove('grabbing'); });
addEventListener('pointerleave', ()=>{ probe.active=false; drag.on=false; canvas.classList.remove('grabbing'); });

// ── Scroll: ScrollHero OWNS Lenis (Layout shares it via window.__cgLenis). ──
const stage = document.getElementById('cgStage');
stage.style.height = (TOTAL_VH + 1) * 100 + 'vh';

let lenis=null;
if(!reducedMotion){
  // lerp 0.15 (up from 0.1): the scroll tracks the wheel/trackpad more closely so it
  // feels tighter and less "floaty / lagging behind" - still smoothed, just less drift.
  lenis = new Lenis({ lerp:0.15, smoothWheel:true, smoothTouch:false });
  window.__cgLenis = lenis;   // Layout reads this and skips creating a second instance
}

const state = { p:0, center:0, shapeW:1 };
function scrollFracToP(f){
  f = clamp(f,0,1);
  let i=0; while(i<N-2 && STOP_F[i+1] <= f) i++;
  const span = STOP_F[i+1]-STOP_F[i] || 1;
  return i + clamp((f-STOP_F[i])/span, 0, 1);
}
function pToScrollY(p){ const max=stage.scrollHeight-innerHeight; return STOP_F[clamp(Math.round(p),0,N-1)]*max; }
// pTarget = where the timeline WANTS to be, from the scroll. state.p eases to it in the
// frame loop (followTau). Driving this from Lenis's TARGET (the immediate wheel/trackpad
// intent) rather than its eased scroll position is what makes the dispersal track the
// wheel 1:1 with no lag - the sticky canvas never moves, so the morph need only follow
// intent. During a programmatic snap we read the eased scroll instead, so the settle
// still honours snapDuration rather than jumping.
let pTarget = 0;
function readScroll(){
  const max = stage.scrollHeight - innerHeight;
  const y = (lenis && !snapping) ? lenis.targetScroll : (scrollY||pageYOffset);
  pTarget = scrollFracToP(max>0 ? y/max : 0);
  const cue = Math.max(0, 1 - y/90); scrollCue.style.opacity = String(cue*0.5);
}
let lastWheelT=-1e9, snapping=false, prevSnapP=0, scrollDir=1;
function noteInput(){ lastWheelT = clock ? clock.elapsedTime*1000 : 0; snapping=false; }
if(lenis){ ['wheel','touchstart','touchmove'].forEach(ev=> addEventListener(ev, noteInput, { passive:true })); }
function maybeSnap(nowMs){
  if(!lenis || drag.on){ prevSnapP = state.p; return; }
  // A snap drives the scroll via lenis.scrollTo (no `lock`), so the user can interrupt
  // it - but Lenis does NOT fire onComplete on an interrupted scrollTo. Clear `snapping`
  // once Lenis has actually come to rest so it can never stick on (which would freeze
  // readScroll on the eased branch and re-create the detachment). noteInput also clears
  // it on any input; this is the belt-and-braces for the momentum-runs-out case.
  if(snapping){ if(!lenis.isScrolling){ snapping = false; } prevSnapP = state.p; return; }
  const sdp = state.p - prevSnapP; prevSnapP = state.p;
  if(Math.abs(sdp) > CONFIG.scroll.snapSettle) scrollDir = Math.sign(sdp);
  // Fire ONLY on a genuine stop: wheel quiet for snapStopMs AND the morph near-still AND
  // Lenis momentum settled - so the snap never fights an active scroll (incl. the gaps
  // between slow wheel notches). snapStopMsHard is a fail-safe: snap by then even if
  // velocity stays jittery, so a sticky momentum can't strand the dust mid-dispersal.
  const quietMs = nowMs - lastWheelT;
  if(quietMs < CONFIG.scroll.snapStopMs) return;
  if(Math.abs(sdp) > CONFIG.scroll.snapSettle) return;
  const settled = Math.abs(lenis.velocity || 0) < CONFIG.scroll.snapVel;
  if(!settled && quietMs < CONFIG.scroll.snapStopMsHard) return;
  // Snap to the NEAREST beat in the travel direction (advanceThresh ~0.4 = only commit
  // forward once you are ~40% into the gap), so a small nudge settles back, not forward.
  const fp = Math.floor(state.p), frac = state.p - fp, th = CONFIG.scroll.advanceThresh;
  let target = scrollDir >= 0 ? (frac > th ? fp+1 : fp) : (frac < 1-th ? fp : fp+1);
  target = clamp(target, 0, N-1);
  if(Math.abs(state.p - target) < 0.004) return;
  snapping = true;
  // Ease OUT (start at once, decelerate into the beat) - reads as a gentle magnetise, not
  // the hold-then-surge the old ease-in-out gave. At velocity~0, animatedScroll ==
  // targetScroll, so the readScroll source-switch into the snap is seamless.
  lenis.scrollTo(pToScrollY(target), { duration: CONFIG.scroll.snapDuration,
    easing: easeOutCubic, onComplete:()=>{ snapping=false; } });
}

// ── Overlay - phase the copy blocks by beat formed-ness. ──
const ov = {
  lead: document.querySelector('.ov-lead'),
  product: document.getElementById('ovProduct'),
  index: document.getElementById('ovIndex'), name: document.getElementById('ovName'),
  meta: document.getElementById('ovMeta'), desc: document.getElementById('ovDesc'), link: document.getElementById('ovLink'),
  hint: document.querySelector('.ov-hint'),
};
const scrollCue = document.getElementById('scrollCue');
let curProductBeat=-1;
function setProductChrome(b){
  if(b===curProductBeat) return; curProductBeat=b; const d=BEATS[b];
  ov.index.textContent = `${String(b).padStart(2,'0')} / ${String(FEATURED_COUNT).padStart(2,'0')}`;
  ov.name.textContent = d.name; ov.meta.textContent = `${d.year} · ${d.disc}`;
  ov.desc.textContent = d.desc || '';
  ov.link.setAttribute('href', `/work/${d.slug}/`);
  // "Drag to spin" applies to the GLB models; the nucleus hands off to the live
  // atom (which carries its own controls), so the hint is hidden there.
  if(ov.hint) ov.hint.style.display = (d.kind==='model') ? '' : 'none';
}
const dotsWrap=document.getElementById('beatDots');
for(let i=0;i<FEATURED_COUNT;i++){ const dot=document.createElement('div'); dot.className='dot'; dotsWrap.appendChild(dot); }
const dots=[...dotsWrap.children];

function updateOverlay(){
  const center=state.center, w=state.shapeW;
  ov.lead.style.opacity = (center===0) ? w : 0;
  const cb=BEATS[center];
  if(cb && (cb.kind==='model' || cb.kind==='nucleus')){ setProductChrome(center); ov.product.style.opacity = w; }
  else ov.product.style.opacity = 0;
  dots.forEach((d,idx)=> d.classList.toggle('on', idx+1===center));
}

// ── Render loop ──
const clock = new THREE.Clock(); clock.getDelta();
let accumY=0, accumX=0;

// Live-atom visibility contract (mirrors window.__cgLenis / theme:change): the
// NuclearAtom island runs a full-viewport canvas-2D loop that would otherwise
// redraw every frame even while the atom is invisible - measured as ~80% of the
// homepage's scroll CPU. We flag when the nucleus is the active beat so the island
// pauses its redraw the rest of the time. Set false up front so the island (which
// hydrates later, on idle) reads "paused" until the nucleus beat is actually reached.
let prevAtomActive = null;
window.__cgAtomActive = false;
// Last-written overlay style values, so the render loop can skip redundant
// per-frame writes (see the atom crossfade block below).
let lastAtomVis = null, lastAtomPE = null;
function setAtomActive(on){
  if(on === prevAtomActive) return;
  prevAtomActive = on; window.__cgAtomActive = on;
  dispatchEvent(new CustomEvent('atom:active', { detail:{ active:on } }));
}

let ready=false;
if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
scrollTo(0,0);
(async function init(){
  await fontReady();
  buildTextTargets();
  ps.home.set(targets[0]);
  startLoadIn();
  ready=true;
  // Load models, then PRE-WARM the GPU (offscreen render) so the first scroll to each
  // product doesn't hitch on a lazy texture upload.
  Promise.all(BEATS.map((b,i)=> b.kind==='model' ? loadModel(i) : b.kind==='nucleus' ? loadNucleus(i) : null)).then(()=>{
    const rt = new THREE.WebGLRenderTarget(4,4);
    models.forEach(m=>{ if(m) m.group.visible = true; });
    renderer.setRenderTarget(rt);
    renderer.render(scene, camera);
    renderer.setRenderTarget(null);
    models.forEach(m=>{ if(m) m.group.visible = false; });
    rt.dispose();
  });
})();

addEventListener('resize', ()=>{ camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix();
  fitCamera(); renderer.setSize(innerWidth,innerHeight,false); sizeScale();
  if(composer){ composer.setPixelRatio(renderer.getPixelRatio()); composer.setSize(innerWidth,innerHeight); } });

// Pause the render loop while the stage is fully off-screen (scrolled into the body).
let visible = true;
new IntersectionObserver(([e])=>{ visible = e.isIntersecting; }, { threshold: 0 }).observe(stage);

function frame(ts){
  requestAnimationFrame(frame);
  if(lenis) lenis.raf(ts);
  if(!ready || !visible) return;
  const rawDt=clock.getDelta(), dt=Math.min(rawDt,1/30), time=clock.elapsedTime;
  readScroll();
  // Ease the timeline to the scroll intent with a tight, frame-rate-independent follow
  // (same settle at 60 and 120 Hz). Small followTau = glued to the wheel; the gentle
  // smoothing absorbs per-notch stepping a raw target would show. No Lenis lerp lag.
  const fk = lenis ? (1 - Math.exp(-dt / CONFIG.scroll.followTau)) : 1;
  state.p += (pTarget - state.p) * fk;
  if(loadIn && loadIn.done){ maybeSnap(time*1000); adaptQuality(rawDt*1000); }

  let c, formW;
  if(loadIn && !loadIn.done){ c=0; formW=1; M.formW=1; }
  else { c=Math.round(clamp(state.p,0,N-1)); resolveMorph(state.p); formW=M.formW; }
  state.center = c; state.shapeW = formW;
  updateOverlay();

  // Fill-rate relief during the screen-filling dispersal (the single section gap):
  // shrink the points (uDisperse->1 at full disperse) so the whole-viewport overdraw
  // costs less on retina/ProMotion. 1-formW peaks mid-dispersal; it is 0 at the formed
  // ends AND during the compact model->model morphs (GAP_DISPERSE false there), which
  // never fill the screen - so only the dispersal is affected. Look-preserving.
  {
    const gi = Math.floor(clamp(state.p, 0, N-2));
    ps.material.uniforms.uDisperse.value = (loadIn && loadIn.done && GAP_DISPERSE[gi]) ? (1 - formW) : 0;
  }

  // How fully the current beat's SOLID form (the GLB skin, or the live atom) has
  // taken over from the dust. Mirrors the per-beat `vis` computed in the loop below.
  // When it is essentially complete the dust is invisible (particleOpacity ~ 0), so
  // we can skip the per-particle sim + buffer upload + points draw for the frame -
  // look-free, and it frees main-thread + fill budget at every rest state (notably
  // while resting on the visible atom, which is itself redrawing).
  const skinnable = !!(BEATS[c] && ((BEATS[c].kind==='model' && models[c]) || BEATS[c].kind==='nucleus'));
  const skinVis = skinnable ? smootherstep(CONFIG.morph.texAt, 1.0, formW) : 0;
  const cloudHidden = !!(loadIn && loadIn.done) && skinVis > 0.99;

  // Drive the live-atom pause: only animate the canvas-2D nucleus once it is about to
  // be VISIBLE (formW past a hair before the atomVis fade-in at texAt=0.62), not for
  // the whole nucleus beat. Below the threshold the atom is both invisible and far
  // from formed, so its full-viewport redraw would only compete with the particle
  // dispersal on the main thread for nothing. The island resumes in one clean frame.
  setAtomActive(c === NUCLEUS_BEAT && !!(loadIn && loadIn.done) && formW > 0.55);

  const activeModel = (BEATS[c]?.kind==='model' && models[c] && formW>0.85) ? c : -1;

  if(c===0 && loadIn && loadIn.done){ accumY += CONFIG.rotation.speed*dt; accumX += (0-accumX)*0.08; }
  else {
    const tgtRY = BEATS[c]?.viewRY || 0, tgtRX = BEATS[c]?.viewRX || 0;
    const aimY = Math.round((accumY - tgtRY)/TAU)*TAU + tgtRY;
    accumY += (aimY - accumY) * 0.08;
    accumX += (tgtRX - accumX) * 0.08;
  }
  dragSpin += dragSpinVel; dragSpinVel *= CONFIG.spin.damping;
  if(activeModel<0){ dragSpin *= 0.94; dragTilt += (0-dragTilt)*CONFIG.spin.returnLerp; }
  const rotY = accumY + dragSpin, rotX = accumX + dragTilt;
  cloudGroup.rotation.set(rotX, rotY, 0);
  cloudGroup.updateMatrixWorld();

  probeUpdate();
  if(loadIn && !loadIn.done) stepLoadIn(time);
  else if(!cloudHidden) stepParticles(dt, probe);   // skip the sim while the dust is fully hidden behind a skinned form

  let particleOpacity = 1;
  for(let i=0;i<N;i++){
    const m=models[i]; if(!m) continue;
    const vis = (i===c) ? smootherstep(CONFIG.morph.texAt, 1.0, formW) : 0;
    m.group.visible = vis>0.001;
    const wantSolid = vis >= 0.985;
    if(wantSolid !== m.solid){ for(const mat of m.materials) mat.depthWrite = wantSolid; m.solid = wantSolid; }
    for(const mat of m.materials) mat.opacity = vis;
    if(i===c) particleOpacity = Math.min(particleOpacity, 1 - vis);
    if(m.group.visible){ m.group.rotation.set(rotX, rotY, 0); m.group.updateMatrixWorld(); }
  }

  // Live-atom crossfade - the nucleus beat hands the dust off to the real atom,
  // the same way models skin on from particles. As the nucleus forms, the overlay
  // fades in and the dust fades out; the overlay captures the pointer only once
  // it's mostly there, so scrolling/dragging other beats is never blocked.
  if(atomOverlay){
    const atomVis = (c===NUCLEUS_BEAT) ? smootherstep(CONFIG.morph.texAt, 1.0, formW) : 0;
    // Only write when the value actually changes: at rest on the formed atom both
    // saturate, and a redundant per-frame style write dirties style and forces the
    // page's layout reads (the atom's own loop, Lenis) into a recalc every frame.
    if(atomVis !== lastAtomVis){ atomOverlay.style.opacity = atomVis; lastAtomVis = atomVis; }
    const pe = atomVis > 0.6 ? 'auto' : 'none';
    if(pe !== lastAtomPE){ atomOverlay.style.pointerEvents = pe; lastAtomPE = pe; }
    particleOpacity = Math.min(particleOpacity, 1 - atomVis);
  }
  ps.material.uniforms.uOpacity.value = particleOpacity;
  // Skip the 140k-point draw call entirely when the dust is invisible (a fully
  // skinned model/atom is covering it) - look-free, saves fill-rate at every rest.
  // Gate on !cloudHidden too so we never draw a frame whose positions we just
  // skipped simming (keeps the buffer and the draw in lockstep).
  ps.points.visible = !cloudHidden && particleOpacity > 0.002;

  canvas.classList.toggle('grabbable', activeModel>=0 && !drag.on);
  // Light mode: the original direct render (unchanged). Dark mode: the lazy
  // bloom composer. The OutputPass in the chain handles tone-mapping + sRGB.
  if(useBloom && composer) composer.render(); else renderer.render(scene, camera);
}
requestAnimationFrame(frame);
</script>
