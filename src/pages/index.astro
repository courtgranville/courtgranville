---
// Homepage. The CG particle hero and the Selected-Work showcase are now a single
// scroll-driven particle narrative (ScrollHero): the CG glyph builds, disperses,
// and re-forms into each product's REAL textured model (grab-and-spin), one after
// the next, closing on a particle-text "Selected Work" divider. Below the narrative,
// in normal flow: an "All work" link, then the titled identity sections (In short
// → What I do → Approach → Background → Colophon → Contact) - opaque, occluding
// the sticky canvas above.

import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import ScrollHero from '../components/ScrollHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import Grid from '../components/Grid.astro';

// What I do - disciplines in the deck's order (lead phrase + description each).
const disciplines: [string, string][] = [
  ['Data Visualisation & Information Design', 'Making complex data navigable for people who aren’t specialists. Turning dense datasets and technical literature into visual systems you can read, explore and trust - drawn in Illustrator, then built interactive in code.'],
  ['Web Design & AI-assisted Development', 'Designing and building interactive sites end to end - HTML, CSS and JavaScript, with AI as a collaborator rather than a crutch. The approach behind both this site and thenuclearquestion.com.'],
  ['UX / UI & Interaction Design', 'Apps and interfaces built around how people actually move through them. User journeys, flows, wireframes and prototyping in Figma - from a productivity app to interactive data tools.'],
  ['Product & Industrial Design', 'Where I trained, and still how I think. Physical objects from lamps to speaker enclosures - modelled in Rhino and Blender, then made real with CNC machining, 3D printing and hands-on fabrication.'],
  ['Brand & Communication Strategy', 'The professional thread: positioning, narrative, market research and paid media, from brand-strategy work at Big Fish and others. The same instinct - shaping how something is understood - from a different angle.'],
];

// Approach - four principles (term + line).
const principles: [string, string][] = [
  ['Research first', 'Understand the system before designing for it.'],
  ['Build to learn', 'Prototype early with whatever the work needs - CNC, 3D printer, Figma, AI.'],
  ['Translate, don’t decorate', 'Make the technical legible, not just pretty.'],
  ['Add meaning, not clutter', 'Improve people’s lives rather than adding to them.'],
];
---
<Layout
  title="Court Granville - Multidisciplinary Designer"
  description="Court Granville is a multidisciplinary designer working across product, interaction, data visualisation and the web - translating complex, contested subjects into things people can understand and use. London & Madrid."
>
  <!-- The hero's heaviest critical assets are otherwise discovered LATE (fetched
       from inside the inline module, which itself waits on the CDN import map):
       preload the nucleus contour data + the first product model, and let the
       browser start three.js itself at first parse. First-paint editorial pages
       don't pay this - it is homepage-only via the Layout head slot. -->
  <Fragment slot="head">
    <!-- crossorigin="anonymous" is REQUIRED on as="fetch" preloads even same-origin:
         a bare preload requests with credentials "include", but fetch()/GLTFLoader
         request with "same-origin" - mismatched credentials = the preload is wasted
         and the asset downloads twice (verified in the network log). -->
    <link rel="preload" href="/nucleus-paths.json" as="fetch" crossorigin="anonymous" />
    <link rel="preload" href="/models/mantis.glb" as="fetch" crossorigin="anonymous" />
    <link rel="modulepreload" href="https://cdn.jsdelivr.net/npm/three@0.162.0/build/three.module.js" crossorigin="anonymous" />
  </Fragment>
  <Nav />
  <main id="main">
    <!-- Screen 1 onward - the scroll-driven particle narrative: CG hero (carrying the
         name + lead as the page h1) → the four featured products (each building from
         particles into its textured model) → a dispersal that hands off to the
         editorial body below. -->
    <ScrollHero />

    <!-- Below the narrative - opaque, occludes the sticky canvas as it scrolls up.
         The identity unfolds across short, titled sections (kicker + title on the
         rail, content on the body), closing with the contact form. -->
    <div class="hp-below">
      <Grid class="hp-allwork-row">
        <a class="textlink hp-allwork reveal" href="/work/">All work &rarr;</a>
      </Grid>

      <!-- In short - the dispersal hands straight into this. -->
      <Grid as="section" id="about" class="hp-sec" aria-label="In short">
        <div class="hp-sec-head t-rail reveal">
          <h2 class="hp-sec-title">In short.</h2>
        </div>
        <div class="hp-sec-body t-body reveal" data-stagger="1">
          <p class="hp-prose">Curiosity about how things and systems work drives most of what I do. My instinct is technological - I reach for whatever lets me build solutions, from a CNC machine and a 3D printer to Figma and code - and I&rsquo;m as comfortable in the workshop as in the browser. Across every discipline, the aim is the same: take something complicated and make it make sense, and make it well.</p>
        </div>
      </Grid>

      <!-- What I do -->
      <Grid as="section" class="hp-sec" aria-label="What I do">
        <div class="hp-sec-head t-rail reveal">
          <h2 class="hp-sec-title">What I do.</h2>
        </div>
        <div class="hp-sec-body t-body reveal" data-stagger="1">
          <p class="hp-lead">I work across disciplines rather than inside one. The common thread is a hands-on, technological approach - reaching for whatever tool builds the idea best.</p>
          <div class="hp-disciplines">
            {disciplines.map(([h, p]) => (
              <div class="hp-disc">
                <h3 class="hp-disc-h">{h}</h3>
                <p class="hp-disc-p">{p}</p>
              </div>
            ))}
          </div>
        </div>
      </Grid>

      <!-- Approach -->
      <Grid as="section" class="hp-sec" aria-label="Approach">
        <div class="hp-sec-head t-rail reveal">
          <h2 class="hp-sec-title">Approach.</h2>
        </div>
        <div class="hp-sec-body t-body reveal" data-stagger="1">
          <p class="hp-lead">I start by understanding the thing itself - the system, the problem, how it works - before designing anything around it. Research first, opinions second. From there I dive in headfirst, reaching for whatever technology the problem demands: a CNC router, a 3D printer, Figma, an AI coding agent. I&rsquo;d rather build a rough prototype and learn from it than theorise, and a tool I&rsquo;ve never touched is a reason to start, not a reason to stop.</p>
          <dl class="hp-principles">
            {principles.map(([t, d]) => (
              <div class="hp-principle">
                <dt class="hp-principle-t">{t}</dt>
                <dd class="hp-principle-d">{d}</dd>
              </div>
            ))}
          </dl>
        </div>
      </Grid>

      <!-- Background -->
      <Grid as="section" class="hp-sec" aria-label="Background">
        <div class="hp-sec-head t-rail reveal">
          <h2 class="hp-sec-title">Background.</h2>
        </div>
        <div class="hp-sec-body t-body reveal" data-stagger="1">
          <p class="hp-prose">I didn&rsquo;t arrive at design the usual way. I studied History, Art History and Maths, spent a foundation year at the City &amp; Guilds of London Art School, and only then found product design at IE University in Madrid. That detour is the point: it taught me to see design as something that sits inside the world - history, systems, people - rather than floating above it. Somewhere along the way, an interest in technology and AI turned a product designer into a multidisciplinary one.</p>
        </div>
      </Grid>

      <!-- Colophon -->
      <Grid as="section" class="hp-sec" aria-label="Colophon">
        <div class="hp-sec-head t-rail reveal">
          <h2 class="hp-sec-title">Colophon.</h2>
        </div>
        <div class="hp-sec-body t-body reveal" data-stagger="1">
          <p class="hp-prose">This site was designed and built by me, with AI as a collaborator rather than a crutch. It&rsquo;s built with Astro - component by component, no template and no page builder - its WebGL hero and 3D work hand-written in three.js, the layout and interaction iterated through Claude, version-managed on GitHub and deployed on Cloudflare Pages. The images are my own work, served at full resolution.</p>
          <p class="hp-prose">I built it this way on purpose. AI has lowered the barrier for designers working close to technology, and this site is one small proof of it: hand-built rather than dropped into a template, every decision still mine. That&rsquo;s exactly the point I&rsquo;d want a portfolio to make.</p>
        </div>
      </Grid>

      <!-- Contact -->
      <Grid as="section" id="contact" class="hp-sec hp-contact" aria-label="Contact">
        <div class="hp-sec-head t-rail reveal">
          <h2 class="hp-sec-title">Contact.</h2>
        </div>
        <div class="hp-sec-body t-body reveal" data-stagger="1">
          <p class="hp-lead">Got a role, a project, or just want to talk about design? Drop me a line.</p>
          <ContactForm />
          <a class="hp-cv label" href="/Court_Granville_CV.pdf" download>Download CV &darr;</a>
        </div>
      </Grid>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* Everything after the narrative, on the white ground, in normal flow. */
  .hp-below {
    position: relative;
    z-index: 2;
    background: var(--bg);
  }

  /* "All work" - a quiet affordance straight after the Selected-Work narrative. */
  :global(.hp-allwork-row) { padding-block: clamp(28px, 5vh, 56px); }
  .hp-allwork { grid-column: 1 / -1; justify-self: start; }

  /* ── Titled sections - kicker + title on t-rail, content on t-body, hairline-
        separated. Mirrors the About page's .ab-sec rhythm. Grid roots render inside
        <Grid> and miss this file's scope hash → :global for the section itself. ── */
  :global(.hp-sec) {
    padding-block: clamp(44px, 8vh, 96px);
    border-top: 1px solid var(--rule);
    row-gap: var(--space-block);
    align-items: start;
    scroll-margin-top: var(--nav-h);
  }
  .hp-sec-head { align-self: start; }
  .hp-sec-title {
    font-family: var(--serif); font-weight: 400;
    font-size: var(--fs-heading-m); line-height: var(--lh-heading-m);
    color: var(--text); margin: 0;
  }

  /* Shared body prose + lead. */
  .hp-prose {
    font-size: var(--fs-body); line-height: var(--lh-body);
    color: var(--text-quiet); margin: 0; max-width: 60ch;
  }
  .hp-prose + .hp-prose { margin-top: 20px; }
  .hp-prose-link { margin-top: var(--space-block); }
  .hp-lead {
    font-size: var(--fs-body); line-height: var(--lh-body);
    color: var(--text-quiet); margin: 0 0 var(--space-block); max-width: 56ch;
  }

  /* Disciplines */
  .hp-disciplines { display: flex; flex-direction: column; gap: clamp(24px, 4vh, 40px); }
  .hp-disc-h {
    font-family: var(--serif); font-weight: 400;
    font-size: var(--fs-heading-s); line-height: var(--lh-heading-s);
    color: var(--text); margin: 0 0 8px;
  }
  .hp-disc-p {
    font-size: var(--fs-body); line-height: var(--lh-body);
    color: var(--text-quiet); margin: 0; max-width: 58ch;
  }

  /* Approach - four principles */
  .hp-principles { margin: 0; display: flex; flex-direction: column; gap: 18px; }
  .hp-principle { display: flex; flex-direction: column; gap: 4px; }
  .hp-principle-t {
    font-family: var(--sans); font-weight: 500;
    font-size: var(--fs-label); line-height: var(--lh-label);
    letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--text);
  }
  .hp-principle-d {
    margin: 0; font-size: var(--fs-body); line-height: var(--lh-body);
    color: var(--text-quiet); max-width: 56ch;
  }

  /* Contact closes the page with a little more breathing room below the form. */
  :global(.hp-contact) { padding-bottom: clamp(72px, 14vh, 160px); }
  /* Download CV - secondary action in label voice, below the form. */
  .hp-cv {
    display: inline-block; margin-top: clamp(24px, 3.2vh, 36px);
    color: var(--text-quiet); padding-bottom: 2px; border-bottom: 1px solid var(--rule);
    transition: color var(--dur-hover) var(--ease-out), border-color var(--dur-hover) var(--ease-out);
  }
  .hp-cv:hover { color: var(--accent); border-bottom-color: var(--accent); }
</style>

<style is:global>
  /* main is the page's positioned wrapper; sections stack in normal flow. */
  main { position: relative; z-index: 2; }
</style>
