---
// Project page template. Each project now opens with its interactive 3D model
// (the same grab-and-spin GLB used on the /work/ gallery), then its title and
// description, then the written story laid out on the shared column grid in the
// homepage's calm rail-kicker + body-prose rhythm - so a project page reads as
// part of the same editorial space.
//
// Layout, top to bottom:
//   1. proj-top    - the interactive model stage (full width). Web/data projects
//                    with no model fall straight through to the intro.
//   2. proj-intro  - discipline·year, the title (serif, upright - no italic) and
//                    the one-line framing, plus any live link / spec / exhibitions.
//   3. proj-sec ×n - one per labelled section: de-numbered kicker on the rail,
//                    body prose on the body track, and (below, full width) the
//                    section's photographs as orientation-grouped justified rows.
//   4. proj-final  - the project's hero studio shot, closing the page.
//
// Images carry no frame or background. Within a section the photos are split into
// landscape and portrait groups so the two orientations are never placed side by
// side, then each group is tiled in "justified" rows: flex-grow proportional to
// each image's aspect makes every image in a row share the same height with no
// crop and no leftover white space. On mobile every row collapses to one image
// at a time. Image slugs resolve against the per-project manifest.

import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Grid from '../../components/Grid.astro';
import ProjectModel from '../../components/r3f/ProjectModel.tsx';
import NuclearAtom from '../../components/nuclear/NuclearAtom.tsx';
import BookletViewer from '../../components/BookletViewer.astro';
import { MODELS } from '../../data/models';

import imageManifest from '../../content/projects-images.json';
import '../../styles/atom.css';

// Canonical order - most-recent-first; matches the Work index.
const ORDER = [
  'the-nuclear-question',
  'mantis',
  'wave',
  'backgammon',
  'lumi',
  'yourpal',
  'spider-209',
  'universal-phone-case',
];

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { slug: p.id.replace(/\.json$/, '') },
    props: { project: p },
  }));
}

const { project } = Astro.props as { project: Awaited<ReturnType<typeof getCollection<'projects'>>>[number] };
const { name, year, discipline, framing, spec, exhibitions, blocks, heroImage, liveUrl } = project.data;

const slug = project.id.replace(/\.json$/, '');
const manifest = (imageManifest as any)[slug];
const modelFraming = MODELS[slug];

function img(imgSlug: string) {
  const entry = manifest?.images.find((i: any) => i.slug === imgSlug);
  if (!entry) {
    throw new Error(`Missing image for ${slug}/${imgSlug} - re-run scripts/process-images.mjs`);
  }
  return entry;
}

// Drop the "01 - " ordinal prefix from a section label: it should just read
// "The Brief". Handles em/en-dash and hyphen separators.
const cleanLabel = (text: string) => text.replace(/^\s*\d+\s*[—–-]\s*/, '');

// ── Group the flat block array into sections at each label boundary ──
type Block = (typeof blocks)[number];
interface ImageEntry { src: string; srcset: string; aspect: number; alt: string; caption?: string }
type RowMode = 'justify' | 'feature';
interface FigRow { items: ImageEntry[]; mode: RowMode }
type TextBlock = Extract<Block, { type: 'text' }>;
type QuoteBlock = Extract<Block, { type: 'quote' }>;
type BookletBlock = Extract<Block, { type: 'booklet' }>;
// A section's prose track is an ordered mix of text and pull-quotes, so quotes
// land exactly where the copy places them. Existing projects use only text.
type BodyBlock = TextBlock | QuoteBlock;
interface Section { label: string | null; body: BodyBlock[]; rows: FigRow[]; booklets: BookletBlock[] }

// Expand a visual block into its image entries (manifest data + alt/caption).
function entriesOf(b: Block): ImageEntry[] {
  if (b.type === 'image') {
    const m = img(b.imageSlug);
    return [{ src: m.src, srcset: m.srcset, aspect: m.aspect, alt: b.alt, caption: b.caption }];
  }
  if (b.type === 'imagePair' || b.type === 'imageGrid') {
    return b.imageSlugs.map((s: string) => {
      const m = img(s);
      return { src: m.src, srcset: m.srcset, aspect: m.aspect, alt: b.alt } as ImageEntry;
    });
  }
  return [];
}

// ── Justified gallery ──────────────────────────────────────────────────────
// One system for every project's photographs. The authored block IS the unit of
// grouping: an `imagePair` is one row of two, an `imageGrid` is one row (split
// only if it exceeds the per-row cap), and a run of consecutive single `image`
// blocks flows together. So the author controls exactly which photos share a row
// by choosing the block - the layout never second-guesses that grouping.
//
// Within a row the images are width-justified: each image's flex-grow is its
// aspect, so a row fills the content width edge to edge and every image in it
// lands on the SAME height with no crop (height = rowWidth / Σ aspect). Portrait
// and landscape therefore sit together cleanly. A single image that is landscape
// fills the width; a single portrait (a poster, the closing hero) stands large at
// a set fraction of the column rather than ballooning to a full-width height.
const GALLERY = {
  target: 2.6,      // ideal Σ aspect per row when flowing a run of single images
  featureWide: 1.3, // a single image at/above this aspect fills the full width;
                    // below it (a portrait poster, the closing hero) it stands
                    // large at a set fraction of the column
  maxRowSum: 4.0,   // a row's Σ aspect ceiling: an authored group of mostly-wide
                    // images that would exceed this is split so the row never gets
                    // too short (height = width / Σ aspect), e.g. three wide CADs
                    // become a pair + a full-width single rather than one squat row
  maxPerRow: 4,     // never cram more than this into one row
};

// Partition a weight sequence into exactly k contiguous groups that minimise the
// largest group's sum (binary-searched cap + greedy fill). Equal group sums →
// equal row heights. A hard per-row count cap keeps small images from stacking
// too many across. Order is preserved, so images stay in their authored sequence.
function partitionContiguous(w: number[], k: number, maxPer: number): number[][] {
  const n = w.length;
  const total = w.reduce((a, b) => a + b, 0);
  const fits = (cap: number) => {
    let groups = 1, sum = 0, count = 0;
    for (const x of w) {
      if (count >= maxPer || (count > 0 && sum + x > cap + 1e-9)) { groups++; sum = x; count = 1; }
      else { sum += x; count++; }
    }
    return groups <= k;
  };
  let lo = Math.max(...w), hi = total;
  for (let it = 0; it < 60; it++) { const mid = (lo + hi) / 2; if (fits(mid)) hi = mid; else lo = mid; }
  const cap = hi;
  const rows: number[][] = []; let row: number[] = []; let sum = 0;
  for (let i = 0; i < n; i++) {
    if (row.length && (row.length >= maxPer || sum + w[i] > cap + 1e-9)) { rows.push(row); row = []; sum = 0; }
    row.push(i); sum += w[i];
  }
  if (row.length) rows.push(row);
  return rows;
}

// Decide how a single row is rendered:
//   justify - flex-grow by aspect, fills the content width edge to edge
//   feature - a single portrait / near-square shown large, left-aligned
function classify(rowAspects: number[]): RowMode {
  if (rowAspects.length >= 2) return 'justify';        // a real row fills the width
  return rowAspects[0] >= GALLERY.featureWide ? 'justify' : 'feature';
}

// Lay one group of images out as justified row(s). An `atomic` group (an authored
// imagePair / imageGrid) stays on a single row unless it exceeds the per-row cap;
// a loose run of single images is flowed to the target height.
function rowsForGroup(entries: ImageEntry[], atomic: boolean): FigRow[] {
  const n = entries.length;
  if (n === 0) return [];
  const w = entries.map((e) => e.aspect);
  const total = w.reduce((a, b) => a + b, 0);
  const k = atomic
    ? Math.min(n, Math.max(Math.ceil(n / GALLERY.maxPerRow), Math.ceil(total / GALLERY.maxRowSum), 1))
    : Math.min(n, Math.max(Math.round(total / GALLERY.target), Math.ceil(n / GALLERY.maxPerRow), 1));
  return partitionContiguous(w, k, GALLERY.maxPerRow).map((idxs) => ({
    items: idxs.map((i) => entries[i]),
    mode: classify(idxs.map((i) => w[i])),
  }));
}

const sections: Section[] = [];
let current: Section | null = null;
let imgBuf: ImageEntry[] = []; // a run of consecutive single `image` blocks
// Flush the pending run of single images as one flowed group before an atomic
// block (imagePair/imageGrid) or a section boundary, so document order holds.
function flushBuf() { if (current && imgBuf.length) { current.rows.push(...rowsForGroup(imgBuf, false)); imgBuf = []; } }
for (const b of blocks) {
  if (b.type === 'label') {
    flushBuf();
    current = { label: b.text, body: [], rows: [], booklets: [] };
    sections.push(current);
  } else {
    if (!current) { current = { label: null, body: [], rows: [], booklets: [] }; sections.push(current); }
    if (b.type === 'text' || b.type === 'quote') current.body.push(b);
    else if (b.type === 'booklet') current.booklets.push(b);
    else if (b.type === 'image') imgBuf.push(...entriesOf(b));
    else { flushBuf(); current.rows.push(...rowsForGroup(entriesOf(b), true)); } // imagePair | imageGrid - one authored row
  }
}
flushBuf();

// The hero studio shot isn't part of the block flow - it closes the page.
const hero = heroImage ? img(heroImage) : null;
const heroPortrait = hero ? hero.aspect < 1.0 : false;

const FIG_SIZES = '(min-width: 1200px) 1100px, 100vw';

// Next-project navigation (cyclic).
const idx = ORDER.indexOf(slug);
const nextSlug = idx >= 0 && idx < ORDER.length - 1 ? ORDER[idx + 1] : ORDER[0];
const allProjects = await getCollection('projects');
const nextProject = allProjects.find((p) => p.id.replace(/\.json$/, '') === nextSlug);
const nextName = nextProject?.data.name ?? '';
---
<Layout title={`${name} - Court Granville`} description={framing}>
  <Nav />
  <main>
    <article>
      <!-- Breadcrumb - a way back to the gallery from the top of the page. -->
      <Grid class="proj-crumb">
        <nav class="proj-crumb-inner" aria-label="Breadcrumb">
          <a class="crumb label" href="/work/">&larr; All work</a>
        </nav>
      </Grid>

      <!-- 1. The hero interaction - the first thing on every project that has one.
           The Nuclear Question leads with the live nucleus atom (cursor-reactive,
           U-235/238 fission); product projects lead with their grab-spin GLB. -->
      {slug === 'the-nuclear-question' ? (
        <Grid class="proj-top">
          <div class="proj-atom-hero">
            <NuclearAtom client:visible viewportParticles />
          </div>
        </Grid>
      ) : modelFraming && (
        <Grid class="proj-top">
          <div class="proj-stage">
            <ProjectModel
              client:visible
              model={modelFraming.model}
              fill={modelFraming.fill}
              viewRY={modelFraming.viewRY}
              viewRX={modelFraming.viewRX}
            />
          </div>
        </Grid>
      )}

      <!-- 2. Title + description, below the model. -->
      <Grid class="proj-intro">
        <div class="proj-intro-inner reveal" data-stagger="1">
          <span class="label proj-meta">{discipline} &middot; {year}</span>
          <h1 class="proj-name">{name}</h1>
          <p class="proj-framing">{framing}</p>
          {liveUrl && (
            <a class="textlink proj-live" href={liveUrl} target="_blank" rel="noopener">Visit the live site &rarr;</a>
          )}
          {spec && (
            <dl class="spec-table proj-spec">
              {Object.entries(spec).map(([k, v]) => (
                <>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </>
              ))}
            </dl>
          )}
          {exhibitions && (
            <div class="proj-exhibitions">
              <span class="label">Exhibited</span>
              <ul>
                {exhibitions.map((line) => <li>{line}</li>)}
              </ul>
            </div>
          )}
        </div>
      </Grid>

      <!-- 3. The written story - kicker on the rail, prose on the body, photos full width. -->
      {sections.map((s) => (
        <Grid class="proj-sec">
          {s.label && (
            <div class="proj-sec-head t-rail reveal">
              <span class="label proj-seclabel">{cleanLabel(s.label)}</span>
            </div>
          )}
          {s.body.length > 0 && (
            <div class="proj-sec-body t-body reveal" data-stagger="1">
              {s.body.map((b) => b.type === 'quote' ? (
                <blockquote class="proj-quote">
                  <p set:html={b.body} />
                  {b.attribution && <cite>{b.attribution}</cite>}
                </blockquote>
              ) : (
                <p class="proj-prose" set:html={b.body} />
              ))}
            </div>
          )}
          {s.rows.length > 0 && (
            <div class="proj-figures reveal">
              {s.rows.map((row) => (
                <div class:list={['fig-row', `fig-row--${row.mode}`]}>
                  {row.items.map((e) => (
                    <figure class="fig" style={row.mode === 'justify' ? `flex-grow:${e.aspect}` : ''}>
                      <img
                        src={e.src}
                        srcset={e.srcset}
                        sizes={FIG_SIZES}
                        alt={e.alt}
                        loading="lazy"
                        decoding="async"
                        style={`aspect-ratio:${e.aspect}`}
                      />
                      {e.caption && <figcaption class="label proj-cap">{e.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              ))}
            </div>
          )}
          {s.booklets.map((bk) => (
            <div class="proj-booklet reveal">
              <BookletViewer pdf={bk.pdf} label={bk.label} downloadText={bk.downloadText} />
            </div>
          ))}
        </Grid>
      ))}

      <!-- 4. The hero studio shot closes the page. -->
      {hero && (
        <Grid class="proj-final">
          <div class="proj-figures reveal">
            <div class:list={['fig-row', heroPortrait ? 'fig-row--feature' : 'fig-row--justify']}>
              <figure class="fig" style={heroPortrait ? '' : `flex-grow:${hero.aspect}`}>
                <img
                  src={hero.src}
                  srcset={hero.srcset}
                  sizes={FIG_SIZES}
                  alt={`${name} - finished`}
                  loading="lazy"
                  decoding="async"
                  style={`aspect-ratio:${hero.aspect}`}
                />
              </figure>
            </div>
          </div>
        </Grid>
      )}

      <Grid class="proj-foot">
        <a class="next-link" href={`/work/${nextSlug}/`}>
          <span class="label next-label">Next project</span>
          <span class="next-name">{nextName} &rarr;</span>
        </a>
        <a class="all-work label" href="/work/">&larr; All work</a>
      </Grid>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  article { padding-top: calc(var(--nav-h) + var(--space-page-top)); }

  /* ── Breadcrumb - a quiet label-voice link back to the gallery, on the rail. ── */
  :global(.proj-crumb) { margin-bottom: var(--space-block); }
  .proj-crumb-inner { grid-column: 1 / -1; }
  .crumb {
    color: var(--text-quiet);
    transition: color var(--dur-hover) var(--ease-out);
  }
  .crumb:hover { color: var(--accent); }

  /* ── 1. Model stage - full content width, a generous fixed height so the model
        reads large. Explicit height (not aspect-ratio) so the canvas drawing
        buffer can't feed back into the box size. Grid roots render inside <Grid>
        and miss this file's scope hash → :global for the container. ── */
  :global(.proj-top) { margin-bottom: var(--space-block); }
  .proj-stage {
    grid-column: 1 / -1;
    position: relative;
    width: 100%;
    height: clamp(340px, 62vh, 720px);
  }
  /* The atom hero (The Nuclear Question) spans the full width; its own
     .atom .hero-icon (atom.css) drives the height. */
  .proj-atom-hero { grid-column: 1 / -1; }
  .proj-stage :global(.proj-stage-canvas) { position: absolute; inset: 0; }
  .proj-stage :global(canvas) {
    width: 100% !important; height: 100% !important; display: block;
    cursor: grab; touch-action: pan-y;
  }
  .proj-stage :global(canvas:active) { cursor: grabbing; }

  /* ── 2. Title + description ── */
  .proj-intro-inner { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 16px; }
  @media (min-width: 768px)  { .proj-intro-inner { grid-column: 1 / 8; } }
  @media (min-width: 1200px) { .proj-intro-inner { grid-column: 1 / 10; } }

  .proj-meta { color: var(--text-quiet); }
  .proj-name {
    font-family: var(--serif); font-weight: 400; font-style: normal;
    font-size: var(--fs-display-l); line-height: var(--lh-display-l);
    color: var(--text); margin: 0;
  }
  /* The framing line - upright, not italic (it used to be), a calm subtitle. */
  .proj-framing {
    font-family: var(--serif); font-weight: 400; font-style: normal;
    font-size: var(--fs-heading-s); line-height: var(--lh-heading-s);
    color: var(--text-quiet); margin: 0; max-width: 38ch;
  }
  .proj-live { width: fit-content; margin-top: 4px; }
  .proj-spec { margin-top: 8px; }
  .proj-exhibitions { margin-top: 8px; }
  .proj-exhibitions ul {
    list-style: none; margin: 8px 0 0; padding: 0;
    display: flex; flex-direction: column; gap: 6px;
  }
  .proj-exhibitions li {
    font-size: var(--fs-body-s); line-height: var(--lh-body-s); color: var(--text);
  }

  /* ── 3. Sections - the homepage's rail-kicker + body-prose rhythm. Sections
        follow on closely (a block, not a full section gap) so the written story
        reads as continuous prose rather than islands separated by big white gaps. ── */
  :global(.proj-sec) {
    margin-top: var(--space-block);
    row-gap: var(--space-block);
    align-items: start;
  }
  .proj-sec-head { align-self: start; }
  .proj-seclabel { display: block; color: var(--text-quiet); }

  .proj-sec-body { display: flex; flex-direction: column; gap: 20px; }
  .proj-prose {
    font-family: var(--sans); font-weight: 400;
    font-size: var(--fs-body); line-height: var(--lh-body);
    color: var(--text-quiet); max-width: 60ch; margin: 0;
  }

  /* Pull-quote - Playfair, full ink (it speaks louder than the prose around it),
     set off by a thin accent rule on the left. Sits in the body track's flow. */
  .proj-quote {
    margin: 4px 0; padding-left: 20px;
    border-left: 1px solid var(--accent);
    max-width: 52ch;
  }
  .proj-quote p {
    font-family: var(--serif); font-weight: 400; font-style: italic;
    font-size: var(--fs-heading-s); line-height: var(--lh-heading-s);
    color: var(--text); margin: 0;
  }
  .proj-quote cite {
    display: block; margin-top: 12px; font-style: normal;
    font-family: var(--sans); font-weight: 500;
    font-size: var(--fs-label); letter-spacing: var(--ls-label);
    text-transform: uppercase; color: var(--text-quiet);
  }

  /* ── Photographs - no frame, no background. Full content width, stacked rows. ── */
  .proj-figures {
    grid-column: 1 / -1;
    margin-top: var(--space-block);
    display: flex; flex-direction: column; gap: var(--gutter);
  }
  /* When a section has no prose, the figures are its only body - pull them up to
     sit directly under the kicker rather than leaving a block of empty space. */
  .proj-sec-head + .proj-figures { margin-top: 0; }

  /* Two row modes:

     .fig-row--justify - the common case. Each image's flex-grow is its aspect, so
       widths are proportional and every image in the row lands on the SAME height,
       the row filling the full content width edge to edge (no crop, no white gap).

     .fig-row--feature - a single portrait / near-square shown large and left
       aligned (a poster, the closing hero). See below. */
  .fig-row { display: flex; gap: var(--gutter); align-items: flex-start; }
  .fig { margin: 0; min-width: 0; }
  .fig img { width: 100%; height: auto; display: block; }
  .proj-cap { display: block; margin-top: 12px; color: var(--text-quiet); }

  .fig-row--justify .fig { flex-basis: 0; }

  /* Feature - a single portrait / near-square shown large and left-aligned. Sized
     by a fraction of the content column, not by viewport height, so it is always
     comfortably over half the width (and reads at a deliberate scale next to the
     full-width landscapes), on any screen. Height follows the image's own aspect,
     so nothing is ever cropped. */
  .fig-row--feature { justify-content: flex-start; --fig-w: 56%; }
  .fig-row--feature .fig { flex: 0 0 auto; width: var(--fig-w); max-width: 100%; }
  .fig-row--feature .fig img { width: 100%; height: auto; }

  /* Mobile - one photograph at a time, each at full width, whatever the row mode. */
  @media (max-width: 767px) {
    .fig-row { flex-direction: column; }
    .fig-row .fig { flex: 1 1 auto; width: 100%; }
    .fig-row .fig img { width: 100%; height: auto; }
  }

  /* ── The booklet - the interactive 3D book (BookletViewer). It sits below its
        section's text, left-aligned on the body track so its left edge lines up
        with the prose; the closed book sits at that left edge and the open
        two-page spread fills rightward from it. ── */
  .proj-booklet {
    grid-column: 1 / -1;
    margin-top: var(--space-block);
    display: flex;
    justify-content: flex-start;
  }
  .proj-booklet > :global(.cg-booklet) { width: 100%; align-items: flex-start; }
  @media (min-width: 768px)  { .proj-booklet { grid-column: 3 / 9; } }
  @media (min-width: 1200px) { .proj-booklet { grid-column: 3 / 12; } }

  /* ── 4. Closing hero shot - the statement image. A landscape hero rides the
        full content width (.fig-row--justify); a portrait hero uses the same tall
        left-aligned .fig-row--feature treatment as a lone in-body portrait. ── */
  :global(.proj-final) { margin-top: var(--space-block); }

  /* ── Footer nav ── */
  :global(.proj-foot) {
    margin-top: var(--space-section);
    padding-bottom: clamp(48px, 6vh, 72px);
    border-top: 1px solid var(--rule);
    padding-top: var(--space-block);
  }
  .next-link, .all-work { grid-column: 1 / -1; display: block; }
  .next-label { display: block; color: var(--text-quiet); margin-bottom: 8px; }
  .next-name {
    font-family: var(--serif); font-weight: 400;
    font-size: var(--fs-heading-m); line-height: var(--lh-heading-m);
    color: var(--text); transition: color var(--dur-hover) var(--ease-out);
  }
  .next-link:hover .next-name { color: var(--accent); }
  .all-work { margin-top: 24px; color: var(--text-quiet); }
  .all-work:hover { color: var(--accent); }

  @media (min-width: 768px) {
    .next-link { grid-column: 1 / 6; }
    .all-work  { grid-column: 7 / 9; margin-top: 0; align-self: end; }
  }
  @media (min-width: 1200px) {
    .next-link { grid-column: 1 / 8; }
    .all-work  { grid-column: 10 / 13; margin-top: 0; align-self: end; }
  }
</style>

<style is:global>
  main { position: relative; z-index: 2; }
</style>
